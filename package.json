{
  "name": "pinultimate-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass src/scss/theme.scss assets/theme.css --load-path=node_modules --no-source-map --style=compressed --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function",
    "build:js": "esbuild src/js/theme.js --bundle --minify --format=iife --target=es2020 --outfile=assets/theme.js",
    "watch": "npm run build:css -- --watch & npm run build:js -- --watch",
    "visual:capture": "node tools/visual/capture.mjs",
    "visual:compare": "node tools/visual/compare.mjs"
  },
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "sass": "^1.105.1",
    "swiper": "^14.3.0"
  }
}
