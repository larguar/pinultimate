{%- liquid
  if section.settings.products != blank
    assign products = section.settings.products
    assign limit = 48
  else
    assign products = section.settings.collection.products
    assign limit = section.settings.collection_limit
  endif
  assign has_products = false
  if section.settings.products != blank or section.settings.collection != blank
    assign has_products = true
  endif
  assign slots = section.settings.bundle_size
-%}

{{ 'section-products-bundle.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-products-bundle.js' | asset_url }}" defer></script>

<products-bundle
  class="products-bundle d-block container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}{% if section.settings.open_on_mobile %} is-open{% endif %}"
  style="--bundle-panel-bg: {{ section.settings.panel_bg_color }}; --bundle-panel-color: {{ section.settings.panel_text_color }};"
  data-minimum="{{ slots }}"
  {% if section.settings.once_per_product %}
    data-once-per-product
  {% endif %}
  {% if section.settings.allow_more %}
    data-allow-more
  {% endif %}
  data-label-add="{{ 'theme.product_page.bundle.add_to_bundle' | t | escape }}"
  data-label-added="{{ 'theme.product_page.bundle.added_to_bundle' | t | escape }}"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="products-bundle__heading">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title fw-normal mb-0">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="products-bundle__subheading mb-0">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="row products-bundle__layout">
      {%- comment -%} Products {%- endcomment -%}
      <div class="col-12 col-md-8 col-lg-9">
        <ul class="products-bundle__grid row row-cols-3 row-cols-sm-4 row-cols-lg-5 row-cols-xl-6 g-0 list-unstyled mb-0" role="list">
          {%- if has_products -%}
            {%- for product in products limit: limit -%}
              {%- liquid
                assign short_title = product.title | split: ' by ' | first | remove: 'Enamel '
                assign variant = product.selected_or_first_available_variant
              -%}
              <li class="col">
                <div
                  class="products-bundle__tile{% unless product.available %} is-unavailable{% endunless %}"
                  data-bundle-product
                  data-product-id="{{ product.id }}"
                  data-title="{{ short_title | escape }}"
                  data-image="{{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' }}"
                  data-image-2x="{{ product.featured_media | image_url: width: 240, height: 240, crop: 'center' }}"
                >
                  <button
                    type="button"
                    class="products-bundle__add d-block w-100 p-0 border-0 bg-transparent"
                    data-bundle-add
                    data-variant-id="{{ variant.id }}"
                    data-variant-title="{% unless product.has_only_default_variant %}{{ variant.title | escape }}{% endunless %}"
                    aria-label="{{ 'theme.product_page.bundle.add_to_bundle' | t }}: {{ short_title | escape }}"
                    title="{{ short_title | escape }}"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    <span class="products-bundle__media ratio ratio-1x1 d-block">
                      {%- if product.featured_media -%}
                        {{
                          product.featured_media
                          | image_url: width: 500
                          | image_tag:
                            class: 'object-fit-cover',
                            alt: '',
                            loading: 'lazy',
                            sizes: '(min-width: 1200px) 12vw, (min-width: 992px) 15vw, (min-width: 576px) 17vw, 33vw',
                            widths: '150, 250, 350, 500'
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'w-100 h-100' }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- unless product.has_only_default_variant -%}
                    <label class="visually-hidden" for="BundleVariant-{{ section.id }}-{{ product.id }}">{{ product.title | escape }}</label>
                    <select
                      id="BundleVariant-{{ section.id }}-{{ product.id }}"
                      class="form-select form-select-sm products-bundle__variant"
                      data-bundle-variant
                    >
                      {%- for v in product.variants -%}
                        {%- if v.available -%}
                          <option value="{{ v.id }}" {% if v.id == variant.id %}selected{% endif %}>{{ v.title | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                  {%- endunless -%}
                </div>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              <li class="col">
                <div class="products-bundle__tile">
                  <span class="products-bundle__media ratio ratio-1x1 d-block bg-tile">
                    {%- assign placeholder = 'product-' | append: i -%}
                    {{ placeholder | placeholder_svg_tag: 'w-100 h-100' }}
                  </span>
                </div>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Bundle panel {%- endcomment -%}
      <div class="col-12 col-md-4 col-lg-3 products-bundle__aside">
        <div class="products-bundle__panel" id="BundlePanel-{{ section.id }}">
          <div class="products-bundle__header d-flex align-items-center justify-content-between">
            <div>
              <h3 class="products-bundle__title mb-0">{{ 'theme.product_page.bundle.title' | t }}</h3>
              {%- if section.settings.discount_title != blank -%}
                <p class="products-bundle__subtitle mb-0">{{ section.settings.discount_title | escape }}</p>
              {%- endif -%}
            </div>
            <button
              type="button"
              class="products-bundle__toggle d-md-none"
              data-bundle-toggle
              aria-expanded="{% if section.settings.open_on_mobile %}true{% else %}false{% endif %}"
              aria-controls="BundleContent-{{ section.id }}"
              aria-label="{{ 'theme.product_page.bundle.toggle' | t }}"
            >
              <span class="products-bundle__toggle-icon" aria-hidden="true"></span>
            </button>
          </div>

          <div class="products-bundle__content" id="BundleContent-{{ section.id }}">
            <ul class="products-bundle__slots list-unstyled" data-bundle-slots role="list">
              {%- for i in (1..slots) -%}
                <li class="products-bundle__slot is-empty" data-bundle-slot>
                  <span class="products-bundle__slot-image" data-bundle-slot-image></span>
                  <span class="products-bundle__slot-text" data-bundle-slot-text>
                    <span class="visually-hidden">{{ 'theme.product_page.bundle.empty_slot' | t }}</span>
                  </span>
                  <button type="button" class="products-bundle__remove" data-bundle-remove hidden>
                    {%- render 'icon', name: 'x-lg' -%}
                    <span class="visually-hidden" data-bundle-remove-label></span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            <p class="visually-hidden" aria-live="polite" data-bundle-status></p>

            <button
              type="button"
              class="btn products-bundle__submit w-100"
              data-bundle-submit
              data-label-remove="{{ 'theme.product_page.bundle.remove' | t: title: '[title]' | escape }}"
              data-label-progress="{{ 'theme.product_page.bundle.progress' | t: count: '[count]', total: '[total]' | escape }}"
              disabled
            >
              {{- 'theme.product_page.bundle.add_bundle' | t -}}
            </button>
            <div class="alert alert-danger small mt-2 mb-0 py-2" role="alert" data-bundle-error hidden></div>
          </div>
        </div>
      </div>
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="text-center mt-4">
        <a href="{{ section.settings.button_link }}" class="btn btn-outline-dark btn-cta">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</products-bundle>

{% schema %}
{
  "name": "Bundle builder",
  "tag": "section",
  "class": "section-products-bundle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your bundle"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Text below the heading"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "collection_limit",
      "label": "Products to show from the collection",
      "min": 3,
      "max": 48,
      "step": 3,
      "default": 12
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Or pick products",
      "info": "Used instead of the collection when set.",
      "limit": 48
    },
    {
      "type": "checkbox",
      "id": "once_per_product",
      "label": "Each product can be added once",
      "default": true
    },
    {
      "type": "header",
      "content": "Bundle"
    },
    {
      "type": "paragraph",
      "content": "Set up the discount itself in Shopify admin (Discounts), e.g. an automatic discount for buying 3 items from the collection."
    },
    {
      "type": "range",
      "id": "bundle_size",
      "label": "Items in a bundle",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "allow_more",
      "label": "Allow more items than that",
      "default": false
    },
    {
      "type": "text",
      "id": "discount_title",
      "label": "Bundle text",
      "default": "Buy 3 pins, get 20% off"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Panel background",
      "default": "#3E3E3E"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel text",
      "default": "#F5F5F5"
    },
    {
      "type": "checkbox",
      "id": "open_on_mobile",
      "label": "Show the bundle contents open on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Bundle builder"
    }
  ]
}
{% endschema %}
