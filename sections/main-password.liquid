{%- comment -%}
  Password page content: a title, optional text, and the message set in
  Online Store > Preferences > Password protection.
{%- endcomment -%}
{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

<section class="main-password container-fluid px-0">
  <div class="container main-password__container">
    {%- if section.settings.title != blank -%}
      <h1 class="main-password__title mb-0">{{ section.settings.title | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="main-password__content rte">{{ section.settings.content }}</div>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <p class="main-password__message mb-0">{{ shop.password_message }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Text"
    },
    {
      "type": "paragraph",
      "content": "The store's password message (Online Store > Preferences) is shown below the text."
    }
  ]
}
{% endschema %}
