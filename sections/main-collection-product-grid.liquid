{%- liquid
  assign has_facets = false
  if section.settings.enable_filtering or section.settings.enable_sorting
    assign has_facets = true
  endif
  if collection.products_count == 0 and collection.filters == empty
    assign has_facets = false
  endif

  assign sidebar = false
  if has_facets and section.settings.filters_layout == 'sidebar'
    assign sidebar = true
  endif

  assign mobile_cols = section.settings.columns_mobile
  if sidebar
    if section.settings.columns_desktop == '4'
      assign grid_cols = 'row-cols-md-2 row-cols-lg-3'
      assign sizes = '(min-width: 1360px) 316px, (min-width: 992px) 23vw, (min-width: 768px) 32vw'
    else
      assign grid_cols = 'row-cols-md-2'
      assign sizes = '(min-width: 1360px) 425px, (min-width: 768px) 32vw'
    endif
  else
    if section.settings.columns_desktop == '4'
      assign grid_cols = 'row-cols-sm-2 row-cols-md-3 row-cols-xl-4'
      assign sizes = '(min-width: 1360px) 316px, (min-width: 1200px) 23vw, (min-width: 768px) 31vw'
    else
      assign grid_cols = 'row-cols-sm-2 row-cols-lg-3'
      assign sizes = '(min-width: 1360px) 425px, (min-width: 992px) 31vw'
    endif
  endif
  if mobile_cols == '1'
    assign sizes = sizes | append: ', (min-width: 576px) 46vw, 92vw'
  else
    assign sizes = sizes | append: ', 46vw'
  endif

  assign drawer_id = 'FacetsDrawer-' | append: section.id
-%}

{{ 'section-main-collection-product-grid.css' | asset_url | stylesheet_tag }}
{%- if has_facets -%}
  <script src="{{ 'section-main-collection-product-grid.js' | asset_url }}" defer></script>
{%- endif -%}

<collection-facets class="collection-grid d-block container-fluid px-0" data-section-id="{{ section.id }}">
  <div class="container">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if has_facets and section.settings.filters_layout == 'top' -%}
        <div class="collection-grid__toolbar d-none d-md-block" data-facets-container="top">
          {% render 'main-collection-product-grid-facets',
            results: collection,
            id_prefix: 'top',
            layout: 'horizontal',
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting
          %}
        </div>
      {%- endif -%}

      {%- if has_facets -%}
        <button
          type="button"
          class="collection-grid__drawer-toggle btn btn-outline-dark w-100 d-md-none"
          data-bs-toggle="offcanvas"
          data-bs-target="#{{ drawer_id }}"
          aria-controls="{{ drawer_id }}"
        >
          {{- 'theme.collection.filter_and_sort' | t -}}
        </button>
      {%- endif -%}

      <div class="row">
        {%- if sidebar -%}
          <aside class="collection-grid__sidebar col-md-4{% if section.settings.columns_desktop == '4' %} col-lg-3{% endif %}">
            {%- comment -%} Inline from md up, a drawer below. {%- endcomment -%}
            <div class="offcanvas-md offcanvas-end drawer" tabindex="-1" id="{{ drawer_id }}" aria-labelledby="{{ drawer_id }}-title">
              <div class="offcanvas-header drawer__header border-bottom">
                <h2 class="offcanvas-title drawer__title" id="{{ drawer_id }}-title">{{ 'theme.collection.filter_and_sort' | t }}</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#{{ drawer_id }}" aria-label="{{ 'accessibility.close' | t }}"></button>
              </div>
              <div class="offcanvas-body collection-grid__facets">
                <div class="w-100" data-facets-container="sidebar">
                  {% render 'main-collection-product-grid-facets',
                    results: collection,
                    id_prefix: 'sidebar',
                    enable_filtering: section.settings.enable_filtering,
                    enable_sorting: section.settings.enable_sorting
                  %}
                </div>
              </div>
            </div>
          </aside>
        {%- endif -%}

        <div class="{% if sidebar %}col-md-8{% if section.settings.columns_desktop == '4' %} col-lg-9{% endif %}{% else %}col-12{% endif %}">
          <div class="collection-grid__results" id="ProductGridResults-{{ section.id }}" data-facets-results="products" aria-live="polite">
            {%- if collection.products.size > 0 -%}
              <ul class="collection-grid__products row row-cols-{{ mobile_cols }} {{ grid_cols }} list-unstyled mb-0" role="list">
                {%- for product in collection.products -%}
                  {%- liquid
                    assign lazy = true
                    if forloop.index <= 6
                      assign lazy = false
                    endif
                  -%}
                  <li class="col">
                    {% render 'product-card',
                      product: product,
                      show_vendor: section.settings.show_vendor,
                      show_price: section.settings.show_price,
                      show_quick_add: section.settings.show_quick_add,
                      sizes: sizes,
                      lazy: lazy
                    %}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                <div class="collection-grid__pagination">
                  {% render 'main-collection-product-grid-pagination', paginate: paginate %}
                </div>
              {%- endif -%}
            {%- elsif collection.filters != empty and collection.products_count > 0 -%}
              {%- liquid
                assign sort_by = collection.sort_by | default: collection.default_sort_by
                assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
              -%}
              <div class="collection-grid__empty py-5">
                <p class="mb-2">{{ 'theme.collection.no_matches' | t }}</p>
                <p class="mb-0">{{ 'theme.collection.use_fewer_filters_html' | t: link: clear_url }}</p>
              </div>
            {%- else -%}
              <div class="collection-grid__empty py-5">
                <p class="mb-0">{{ 'theme.collection.empty' | t }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if has_facets and section.settings.filters_layout == 'top' -%}
        <div class="offcanvas offcanvas-end drawer" tabindex="-1" id="{{ drawer_id }}" aria-labelledby="{{ drawer_id }}-title">
          <div class="offcanvas-header drawer__header border-bottom">
            <h2 class="offcanvas-title drawer__title" id="{{ drawer_id }}-title">{{ 'theme.collection.filter_and_sort' | t }}</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'accessibility.close' | t }}"></button>
          </div>
          <div class="offcanvas-body collection-grid__facets">
            <div class="w-100" data-facets-container="drawer">
              {% render 'main-collection-product-grid-facets',
                results: collection,
                id_prefix: 'drawer',
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting
              %}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</collection-facets>

{% schema %}
{
  "name": "Product grid",
  "tag": "div",
  "class": "section-main-collection-product-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Show filters",
      "info": "Set up filters with the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Show sorting",
      "default": true
    },
    {
      "type": "select",
      "id": "filters_layout",
      "label": "Filter position",
      "options": [
        { "value": "sidebar", "label": "Sidebar" },
        { "value": "top", "label": "Above the products" }
      ],
      "default": "sidebar"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Grid width on desktop",
      "info": "With the sidebar, it takes one of these columns.",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show maker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "info": "A + button on the image. Adds products without options to the cart.",
      "default": true
    }
  ]
}
{% endschema %}
