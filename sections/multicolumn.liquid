{%- liquid
  assign carousel = false
  if section.settings.layout == 'carousel'
    assign carousel = true
  endif

  assign columns = section.settings.columns_desktop | plus: 0
  assign columns_tablet = section.settings.columns_tablet | plus: 0
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  if columns_tablet > columns
    assign columns_tablet = columns
  endif
  if columns_mobile > columns_tablet
    assign columns_mobile = columns_tablet
  endif
  assign columns_small = columns_mobile | plus: 1
  if columns_small > columns_tablet
    assign columns_small = columns_tablet
  endif

  assign logo = false
  if section.settings.media_style == 'logo'
    assign logo = true
  endif
  assign card_style = section.settings.card_style

  case section.settings.image_ratio
    when 'square'
      assign ratio = 100
    when 'landscape'
      assign ratio = 66.667
    when 'standard'
      assign ratio = 75
    when 'portrait'
      assign ratio = 125
    else
      assign ratio = nil
  endcase

  if section.settings.text_alignment == 'center'
    assign align_class = 'text-center'
  else
    assign align_class = 'text-start'
  endif

  assign background_class = ''
  if section.settings.background != 'none'
    assign background_class = 'bg-' | append: section.settings.background
  endif

  assign spacing = section.settings.spacing
  assign slider_label = section.settings.heading
  if slider_label == blank
    assign slider_label = 'theme.content.slider.label' | t
  endif

  assign image_sizes = '(min-width: 992px) calc(100vw / ' | append: columns | append: '), (min-width: 768px) calc(100vw / ' | append: columns_tablet | append: '), calc(100vw / ' | append: columns_mobile | append: ')'
-%}
{%- capture spacing_class -%}
  {%- if spacing == 'compact' -%}
    mt-4 mt-md-6
  {%- else -%}
    {%- render 'section-spacing', size: spacing -%}
  {%- endif -%}
  {%- if section.settings.background != 'none' %} py-4 py-md-6 py-lg-7 py-xl-8{% endif -%}
{%- endcapture -%}

{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

<section class="multicolumn container-fluid px-0 {{ background_class }} {{ spacing_class }}">
  <div class="container">
    {% render 'multicolumn-heading',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      size: section.settings.heading_size,
      italic: section.settings.heading_italic,
      layout: section.settings.heading_layout,
      alignment: section.settings.heading_alignment,
      heading_tag: section.settings.heading_tag
    %}

    {%- if section.blocks.size > 0 -%}
      {%- if carousel -%}
        <swiper-slider
          class="content-slider d-block"
          data-options='{
            "slidesPerView": {{ columns_mobile }},
            "slidesPerGroup": {{ columns_mobile }},
            "spaceBetween": 4,
            "breakpoints": {
              "576": { "slidesPerView": {{ columns_small }}, "slidesPerGroup": {{ columns_small }} },
              "768": { "slidesPerView": {{ columns_tablet }}, "slidesPerGroup": {{ columns_tablet }} },
              "992": { "slidesPerView": {{ columns }}, "slidesPerGroup": {{ columns }} },
              "1200": { "slidesPerView": {{ columns }}, "slidesPerGroup": {{ columns }}, "spaceBetween": 5 }
            }
          }'
        >
          <div class="swiper" aria-label="{{ slider_label | escape }}">
            <div class="swiper-wrapper">
      {%- else -%}
        <div class="row row-cols-{{ columns_mobile }} row-cols-sm-{{ columns_small }} row-cols-md-{{ columns_tablet }} row-cols-lg-{{ columns }} g-1">
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign has_text = false
          if block.settings.title != blank or block.settings.text != blank or block.settings.link_label != blank
            assign has_text = true
          endif
        -%}
        <div class="{% if carousel %}swiper-slide{% else %}col{% endif %}" {{ block.shopify_attributes }}>
          <div class="multicolumn__item multicolumn__item--{{ card_style }} h-100 position-relative {{ align_class }}">
            {%- if image != blank -%}
              {%- if logo -%}
                <div class="multicolumn__logo d-flex align-items-center {% if section.settings.text_alignment != 'center' and has_text %}justify-content-start{% else %}justify-content-center{% endif %}">
                  {{
                    image
                    | image_url: width: 320
                    | image_tag:
                      class: 'multicolumn__logo-image object-fit-contain',
                      widths: '128, 192, 256, 320',
                      sizes: '128px',
                      loading: 'lazy'
                  }}
                </div>
              {%- elsif ratio -%}
                <div class="ratio multicolumn__media" style="--bs-aspect-ratio: {{ ratio }}%;">
                  {{
                    image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'object-fit-cover',
                      widths: '300, 450, 600, 900, 1200',
                      sizes: image_sizes,
                      loading: 'lazy'
                  }}
                </div>
              {%- else -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'multicolumn__media d-block w-100 h-auto',
                    widths: '300, 450, 600, 900, 1200',
                    sizes: image_sizes,
                    loading: 'lazy'
                }}
              {%- endif -%}
            {%- elsif block.settings.icon != 'none' -%}
              <div class="multicolumn__icon fs-1 lh-1">
                {%- render 'icon', name: block.settings.icon -%}
              </div>
            {%- endif -%}

            {%- if has_text -%}
              <div class="multicolumn__text">
                {%- if block.settings.title != blank -%}
                  <h3 class="multicolumn__title h5 fw-semibold mb-2">
                    {%- if block.settings.link != blank and block.settings.link_label == blank -%}
                      <a href="{{ block.settings.link }}" class="stretched-link text-reset">{{ block.settings.title | escape }}</a>
                    {%- else -%}
                      {{- block.settings.title | escape -}}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="multicolumn__body rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                  <a href="{{ block.settings.link }}" class="multicolumn__link d-inline-block mt-3 text-decoration-underline">
                    {{- block.settings.link_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- elsif block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="stretched-link">
                <span class="visually-hidden">{{ image.alt | default: block.settings.link }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if carousel -%}
            </div>
          </div>
          {% render 'multicolumn-slider-nav' %}
        </swiper-slider>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- elsif carousel -%}
      {%- comment -%} An empty carousel keeps the space above its controls, as before. {%- endcomment -%}
      <div class="content-slider"><div class="content-slider__nav"></div></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "div",
  "class": "section-multicolumn",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Multicolumn"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "heading_layout",
      "label": "Subheading position",
      "options": [
        { "value": "stacked", "label": "Below the heading" },
        { "value": "inline", "label": "Beside the heading" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "heading_italic",
      "label": "Italic heading",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "For search engines and screen readers; doesn't change the look.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phone",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "Image style",
      "options": [
        { "value": "image", "label": "Full-width image" },
        { "value": "logo", "label": "Logo" }
      ],
      "default": "image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Full-width images only.",
      "options": [
        { "value": "adapt", "label": "Original" },
        { "value": "square", "label": "Square" },
        { "value": "standard", "label": "Landscape (4:3)" },
        { "value": "landscape", "label": "Wide (3:2)" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Column style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "card", "label": "White card" },
        { "value": "bordered", "label": "White card with border" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" },
        { "value": "green", "label": "Green" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "compact", "label": "Extra small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Shown when there's no image.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "box-seam", "label": "Box" },
            { "value": "bag", "label": "Shopping bag" },
            { "value": "cart", "label": "Cart" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "geo-alt", "label": "Map pin" },
            { "value": "telephone", "label": "Phone" },
            { "value": "envelope", "label": "Envelope" },
            { "value": "check-circle", "label": "Check mark" },
            { "value": "info-circle", "label": "Info" },
            { "value": "question-circle", "label": "Question" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Column"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Pair text with an image to focus on your chosen product, collection or blog post."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Leave blank to make the whole column clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    },
    {
      "name": "Logo carousel",
      "settings": {
        "heading": "Brands we've worked with",
        "heading_size": "small",
        "layout": "carousel",
        "columns_desktop": 5,
        "columns_tablet": 4,
        "columns_mobile": "2",
        "media_style": "logo",
        "card_style": "card",
        "background": "light"
      }
    }
  ]
}
{% endschema %}
