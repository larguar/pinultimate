{%- liquid
  assign image = section.settings.image
  assign position = section.settings.image_position
  if image == blank or position == 'none'
    assign position = 'none'
  endif

  case section.settings.text_alignment
    when 'center'
      assign text_class = 'text-center'
      assign buttons_class = 'align-items-center justify-content-md-center'
    when 'right'
      assign text_class = 'text-end'
      assign buttons_class = 'align-items-end justify-content-md-end'
    else
      assign text_class = 'text-start'
      assign buttons_class = 'align-items-start'
  endcase

  assign background_class = ''
  if section.settings.background != 'none'
    assign background_class = 'text-bg-' | append: section.settings.background
  endif

  # Buttons that stay visible on dark backgrounds.
  assign solid_button = 'btn-primary'
  assign outline_button = 'btn-outline-dark'
  case section.settings.background
    when 'dark'
      assign outline_button = 'btn-outline-light'
    when 'primary'
      assign solid_button = 'btn-light'
      assign outline_button = 'btn-outline-light'
  endcase

  assign spacing = section.settings.spacing
-%}
{%- capture spacing_class -%}
  {%- if spacing == 'compact' -%}
    mt-4 mt-md-6
  {%- else -%}
    {%- render 'section-spacing', size: spacing -%}
  {%- endif -%}
  {%- if section.settings.bottom_spacing %} {% render 'section-spacing', side: 'b' %}{% endif -%}
{%- endcapture -%}

{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

<section class="rich-text rich-text--height-{{ section.settings.height }} container-fluid px-0 {{ spacing_class }}">
  <div class="{% if section.settings.full_width %}container-fluid px-0{% else %}container{% endif %}">
    <div class="row g-0 rich-text__row {{ background_class }}">
      {%- if position != 'none' -%}
        <div class="col-12{% unless position == 'top' %} col-md-6{% endunless %} rich-text__media rich-text__media--{{ position }}{% if position == 'right' %} order-md-last{% endif %}{% if section.settings.image_fit == 'contain' %} rich-text__media--contain{% endif %}">
          {%- liquid
            if position == 'top'
              assign sizes = '(min-width: 1400px) 1360px, 100vw'
            else
              assign sizes = '(min-width: 1400px) 680px, (min-width: 768px) 50vw, 100vw'
            endif
            if section.index == 1
              assign loading = 'eager'
            else
              assign loading = 'lazy'
            endif
            echo image | image_url: width: 2000 | image_tag: class: 'rich-text__image d-block w-100 h-auto', sizes: sizes, widths: '375, 550, 750, 1000, 1360, 1600, 2000', loading: loading, alt: image.alt
          -%}
        </div>
      {%- endif -%}

      <div class="col-12{% if position == 'left' or position == 'right' %} col-md-6{% endif %} rich-text__text d-flex align-items-center">
        <div
          class="rich-text__content w-100 {{ text_class }}"
          style="--rich-text-spacing: {{ section.settings.content_spacing }}px; --rich-text-button-spacing: {{ section.settings.button_spacing }}px;"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign previous_type = ''
              unless forloop.first
                assign previous_index = forloop.index0 | minus: 1
                assign previous_type = section.blocks[previous_index].type
              endunless
              assign next_type = section.blocks[forloop.index].type
            -%}
            {%- case block.type -%}
              {%- when 'eyebrow' -%}
                {%- if block.settings.text != blank -%}
                  <p
                    class="rich-text__eyebrow eyebrow mb-0{% if section.settings.text_alignment == 'center' %} mx-auto{% endif %}"
                    {% if block.settings.max_width_mobile > 0 %}
                      style="--rich-text-eyebrow-max-width: {{ block.settings.max_width_mobile }}px;"
                    {% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </p>
                {%- endif -%}

              {%- when 'title' -%}
                {%- if block.settings.title != blank -%}
                  <{{ block.settings.heading_tag }}
                    class="rich-text__title rich-text__title--{{ block.settings.size }} mb-0"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.title | escape -}}
                  </{{ block.settings.heading_tag }}>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="rich-text__body rte" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'button' -%}
                {%- comment -%} Consecutive buttons are collected and shown side by side. {%- endcomment -%}
                {%- if previous_type != 'button' -%}
                  {%- assign buttons_html = '' -%}
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  {%- capture button_html -%}
                    <a
                      {% if block.settings.link != blank %}
                        href="{{ block.settings.link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="btn btn-cta {% if block.settings.style == 'outline' %}{{ outline_button }}{% else %}{{ solid_button }}{% endif %}"
                      {% if block.settings.new_tab %}
                        target="_blank" rel="noopener"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{- block.settings.label | escape -}}
                    </a>
                  {%- endcapture -%}
                  {%- assign buttons_html = buttons_html | append: button_html -%}
                {%- endif -%}
                {%- if next_type != 'button' and buttons_html != blank -%}
                  <div class="rich-text__buttons d-flex flex-column flex-md-row flex-md-wrap {{ buttons_class }}">
                    {{- buttons_html -}}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "div",
  "class": "section-rich-text",
  "max_blocks": 12,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "On phones the image always sits above the text.",
      "options": [
        { "value": "none", "label": "No image" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Above the text" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the space (crop)" },
        { "value": "contain", "label": "Show the whole image" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Minimum height",
      "options": [
        { "value": "auto", "label": "Fit content" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_spacing",
      "label": "Space between blocks",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_spacing",
      "label": "Space above buttons",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" },
        { "value": "green", "label": "Green" },
        { "value": "primary", "label": "Dark green" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full page width",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "compact", "label": "Extra small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "bottom_spacing",
      "label": "Add space below",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Small heading",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Small heading",
          "info": "Shown in small uppercase letters."
        },
        {
          "type": "range",
          "id": "max_width_mobile",
          "label": "Maximum width on phones",
          "info": "Use to control where the text wraps on small screens. 0 means no limit.",
          "min": 0,
          "max": 400,
          "step": 10,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "title",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Talk about your brand"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading level",
          "info": "For search engines and screen readers; doesn't change the look.",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "settings": {
        "image_position": "none",
        "height": "auto"
      },
      "blocks": [
        { "type": "eyebrow" },
        { "type": "title" },
        { "type": "text" },
        { "type": "button" }
      ]
    },
    {
      "name": "Image with text",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "title" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
