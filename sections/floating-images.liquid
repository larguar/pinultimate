    {
      "type": "select",
      "id": "title_size",
      "label": "Heading size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra large" }
      ],
      "default": "regular"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Dark green" },
        { "value": "outline-dark", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-center"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" },
        { "value": "primary", "label": "Dark green" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        { "value": "dark", "label": "Black" },
        { "value": "primary", "label": "Dark green" },
        { "value": "white", "label": "White" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "invert_text",
      "label": "Invert text colors over images",
      "info": "Keeps the text readable where it overlaps images. Works best with white text.",
      "default": false
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height on desktop",
      "info": "As a share of the screen height. Items further down are cut off.",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height on mobile and tablet",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Cut-out images with a transparent background work best."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "speed",
