{%- comment -%}
  A heading and button with images (or short texts) floating around them. Each item is placed
  with offsets from the section's top-left corner, separately for mobile, and can drift with a
  parallax effect on larger screens (src/js/sections/floating-images.js).
{%- endcomment -%}
{%- liquid
  assign background_class = ''
  if section.settings.background != 'none'
    assign background_class = 'bg-' | append: section.settings.background
  endif

  case section.settings.text_position
    when 'top-left'
      assign position_class = 'justify-content-start align-items-start'
    when 'top-center'
      assign position_class = 'justify-content-center align-items-start text-center'
    when 'top-right'
      assign position_class = 'justify-content-end align-items-start text-end'
    when 'middle-left'
      assign position_class = 'justify-content-start align-items-center'
    when 'middle-right'
      assign position_class = 'justify-content-end align-items-center text-end'
    when 'bottom-left'
      assign position_class = 'justify-content-start align-items-end'
    when 'bottom-center'
      assign position_class = 'justify-content-center align-items-end text-center'
    when 'bottom-right'
      assign position_class = 'justify-content-end align-items-end text-end'
    else
      assign position_class = 'justify-content-center align-items-center text-center'
  endcase
-%}

{{ 'section-floating-images.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-floating-images.js' | asset_url }}" defer="defer"></script>

<section class="floating-images container-fluid px-0 {{ background_class }} text-{{ section.settings.text_color }} {% render 'section-spacing', size: section.settings.spacing %}">
  <floating-images
    class="floating-images__stage container-fluid px-0 d-block position-relative overflow-hidden"
    style="--fi-height: {{ section.settings.height }}vh; --fi-height-mobile: {{ section.settings.height_mobile }}vh;"
  >
    <div class="row g-0 h-100">
      <div class="col-12 h-100">
        {%- for block in section.blocks -%}
          {%- liquid
            assign max_x = 100 | minus: block.settings.width
            assign x = block.settings.x | at_most: max_x
            assign z = forloop.length | minus: forloop.index0
            capture sizes
              echo '(min-width: 768px) ' | append: block.settings.width | append: 'vw, ' | append: block.settings.width_mobile | append: 'vw'
            endcapture
          -%}
          <div
            class="floating-images__item floating-images__item--{{ block.type }} position-absolute{% if block.settings.hide_on_mobile %} d-none d-md-block{% endif %}{% if block.settings.hide_on_desktop %} d-md-none{% endif %}"
            style="--fi-x: {{ x }}%; --fi-y: {{ block.settings.y }}vh; --fi-width: {{ block.settings.width }}%; --fi-x-mobile: {{ block.settings.x_mobile }}%; --fi-y-mobile: {{ block.settings.y_mobile }}vh; --fi-width-mobile: {{ block.settings.width_mobile }}%; z-index: {{ z }};"
            {% if block.settings.speed != 0 %}
              data-speed="{{ block.settings.speed | divided_by: 10.0 }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- case block.type -%}
              {%- when 'image' -%}
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="d-block">{%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag: widths: '200, 400, 600, 800, 1200', sizes: sizes, loading: 'lazy', class: 'd-block w-100 h-auto'
                  }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'd-block w-100 h-auto bg-white' }}
                {%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              {%- when 'text' -%}
                <div class="rte text-{{ block.settings.color }}{% if block.settings.background != 'none' %} bg-{{ block.settings.background }} p-3 p-md-4{% endif %}">
                  {{ block.settings.text }}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}

        <div class="floating-images__content{% if section.settings.invert_text %} floating-images__content--invert{% endif %} container position-relative h-100 d-flex {{ position_class }}">
          <div class="floating-images__text py-5">
            {%- if section.settings.caption != blank -%}
              <p class="eyebrow mb-3">{{ section.settings.caption | escape }}</p>
            {%- endif -%}
            {%- if section.settings.title != blank -%}
              <h2 class="floating-images__title floating-images__title--{{ section.settings.title_size }} rte">
                {{- section.settings.title | remove: '<p>' | remove: '</p>' -}}
              </h2>
            {%- endif -%}
            {%- if section.settings.button_label != blank -%}
              <a
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="btn btn-{{ section.settings.button_style }} btn-cta mt-4"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </floating-images>
</section>

{% schema %}
{
  "name": "Floating images",
  "tag": "div",
  "class": "section-floating-images",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Small uppercase text above the heading."
