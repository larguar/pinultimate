          "min": -20,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 40
        },
        {
          "type": "checkbox",
          "id": "hide_on_desktop",
          "label": "Hide on desktop",
          "default": false
        },
        {
          "type": "header",
          "content": "Mobile"
        },
        {
          "type": "range",
          "id": "width_mobile",
          "label": "Width",
          "min": 5,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 40
        },
        {
          "type": "range",
          "id": "x_mobile",
          "label": "From the left",
          "min": -20,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 30
        },
