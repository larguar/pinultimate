{%- liquid
  assign has_facets = false
  if section.settings.enable_filtering or section.settings.enable_sorting
    assign has_facets = search.performed
  endif

  case section.settings.columns_desktop
    when '3'
      assign grid_cols = 'row-cols-sm-2 row-cols-md-3'
      assign sizes = '(min-width: 1360px) 425px, (min-width: 768px) 31vw'
    else
      assign grid_cols = 'row-cols-sm-2 row-cols-md-3 row-cols-lg-4'
      assign sizes = '(min-width: 1360px) 316px, (min-width: 992px) 23vw, (min-width: 768px) 31vw'
  endcase
  if section.settings.columns_mobile == '1'
    assign sizes = sizes | append: ', (min-width: 576px) 46vw, 92vw'
  else
    assign sizes = sizes | append: ', 46vw'
  endif

  assign drawer_id = 'FacetsDrawer-' | append: section.id
  assign button_label = 'theme.collection.search.submit' | t
  if search.performed and search.results_count > 0
    assign button_label = 'theme.collection.search.search_again' | t
  endif
-%}

{{ 'section-main-collection-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'section-main-search.css' | asset_url | stylesheet_tag }}
{%- if has_facets -%}
  <script src="{{ 'section-main-collection-product-grid.js' | asset_url }}" defer></script>
{%- endif -%}

<collection-facets class="main-search d-block container-fluid px-0" data-section-id="{{ section.id }}">
  <div class="container">
    <h1 class="main-search__title mb-0">{{ 'theme.collection.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="main-search__form d-flex">
      <label class="visually-hidden" for="MainSearch-{{ section.id }}">{{ 'theme.collection.search.label' | t }}</label>
      <input
        type="search"
        id="MainSearch-{{ section.id }}"
        name="q"
        class="main-search__input form-control flex-fill"
        placeholder="{{ 'theme.collection.search.placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="main-search__submit btn btn-dark d-flex flex-column align-items-center justify-content-center">
        <span class="main-search__submit-icon d-flex align-items-center" aria-hidden="true">
          <svg width="21" height="9" viewBox="0 0 21 9" fill="none" focusable="false"><path d="M0 4.5h20M16 .5l4 4-4 4" stroke="currentColor"/></svg>
        </span>
        <span>{{ button_label }}</span>
      </button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- liquid
          assign offset = paginate.current_offset | plus: 1
          assign page_size = paginate.current_offset | plus: paginate.page_size | at_most: paginate.items
          assign products = search.results | where: 'object_type', 'product'
          assign articles = search.results | where: 'object_type', 'article'
          assign pages = search.results | where: 'object_type', 'page'
        -%}
        <div class="main-search__results">
          {%- if search.results_count == 0 and search.filters == empty -%}
            <p class="main-search__summary">{{ 'theme.collection.search.no_results' | t: terms: search.terms }}</p>
          {%- else -%}
            <div data-facets-results="summary">
              <p class="main-search__summary">{{ 'theme.collection.search.results' | t: count: search.results_count, terms: search.terms }}</p>
              {%- if products.size > 0 or search.filters != empty -%}
                <h2 class="main-search__heading">{{ 'theme.collection.search.products' | t: count: products.size }}</h2>
              {%- endif -%}
            </div>

            {%- if has_facets -%}
              {%- if products.size > 0 or search.filters != empty -%}
                <div class="main-search__toolbar d-none d-md-block" data-facets-container="top">
                  {% render 'main-collection-product-grid-facets',
                    results: search,
                    id_prefix: 'top',
                    layout: 'horizontal',
                    enable_filtering: section.settings.enable_filtering,
                    enable_sorting: section.settings.enable_sorting
                  %}
                </div>
              {%- endif -%}
            {%- endif -%}

            <div data-facets-results="products" aria-live="polite">
              {%- if products.size > 0 or search.filters != empty -%}
                <p class="main-search__count mb-0">
                  {{- 'theme.collection.search.showing' | t: offset: offset, page_size: page_size, count: paginate.items -}}
                </p>
              {%- endif -%}

              {%- if has_facets -%}
                <button
                  type="button"
                  class="collection-grid__drawer-toggle main-search__drawer-toggle btn btn-outline-dark w-100 d-md-none"
                  data-bs-toggle="offcanvas"
                  data-bs-target="#{{ drawer_id }}"
                  aria-controls="{{ drawer_id }}"
                >
                  {{- 'theme.collection.filter_and_sort' | t -}}
                </button>
              {%- endif -%}

              {%- if products.size > 0 -%}
                <ul class="collection-grid__products row row-cols-{{ section.settings.columns_mobile }} {{ grid_cols }} list-unstyled mb-0" role="list">
                  {%- for product in products -%}
                    {%- liquid
                      assign lazy = true
                      if forloop.index <= 4
                        assign lazy = false
                      endif
                    -%}
                    <li class="col">
                      {% render 'product-card',
                        product: product,
                        show_vendor: section.settings.show_vendor,
                        show_price: section.settings.show_price,
                        show_quick_add: section.settings.show_quick_add,
                        sizes: sizes,
                        lazy: lazy
                      %}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- elsif search.filters != empty -%}
                {%- liquid
                  assign sort_by = search.sort_by | default: search.default_sort_by
                  assign clear_url = routes.search_url | append: '?q=' | append: search.terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
                -%}
                <div class="py-5">
                  <p class="mb-2">{{ 'theme.collection.no_matches' | t }}</p>
                  <p class="mb-0">{{ 'theme.collection.use_fewer_filters_html' | t: link: clear_url }}</p>
                </div>
              {%- endif -%}

              {%- if articles.size > 0 -%}
                <h2 class="main-search__heading main-search__heading--spaced">{{ 'theme.collection.search.articles' | t: count: articles.size }}</h2>
                <div class="main-search__articles row row-cols-1 row-cols-md-3">
                  {%- for article in articles -%}
                    <div class="col">
                      <a href="{{ article.url }}" class="main-search__article d-block text-reset text-decoration-none">
                        <span class="main-search__article-image d-block ratio ratio-5x6 bg-tile">
                          {%- if article.image -%}
                            {{ article.image | image_url: width: 900 | image_tag: class: 'object-fit-cover', alt: '', loading: 'lazy', sizes: '(min-width: 1360px) 425px, (min-width: 768px) 31vw, 92vw', widths: '400, 600, 900' }}
                          {%- else -%}
                            <span class="d-flex align-items-center justify-content-center">
                              <svg class="main-search__article-placeholder" viewBox="0 0 82 64" aria-hidden="true" focusable="false"><rect x="1" y="1" width="80" height="62" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="6" y="6" width="70" height="52" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="25" cy="21" r="5" fill="none" stroke="currentColor"/><path d="M6 50c10-14 22-20 34-18s20 10 36 4" fill="none" stroke="currentColor"/></svg>
                            </span>
                          {%- endif -%}
                        </span>
                        <span class="main-search__article-title d-block">{{ article.title | escape }}</span>
                      </a>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              {%- if pages.size > 0 -%}
                <h2 class="main-search__heading main-search__heading--spaced">{{ 'theme.collection.search.pages' | t: count: pages.size }}</h2>
                {%- for page in pages -%}
                  <div class="main-search__page">
                    <a href="{{ page.url }}" class="main-search__page-title text-reset">{{ page.title | escape }}</a>
                    {%- assign excerpt = page.content | strip_html | truncatewords: 60 -%}
                    {%- if excerpt != blank -%}
                      <p class="main-search__page-excerpt mb-0">{{ excerpt }}</p>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              {%- endif -%}

              {%- if paginate.pages > 1 -%}
                <div class="collection-grid__pagination">
                  {% render 'main-collection-product-grid-pagination', paginate: paginate %}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if has_facets -%}
          <div class="offcanvas offcanvas-end drawer" tabindex="-1" id="{{ drawer_id }}" aria-labelledby="{{ drawer_id }}-title">
            <div class="offcanvas-header drawer__header border-bottom">
              <h2 class="offcanvas-title drawer__title" id="{{ drawer_id }}-title">{{ 'theme.collection.filter_and_sort' | t }}</h2>
              <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="{{ 'accessibility.close' | t }}"></button>
            </div>
            <div class="offcanvas-body collection-grid__facets">
              <div class="w-100" data-facets-container="drawer">
                {% render 'main-collection-product-grid-facets',
                  results: search,
                  id_prefix: 'drawer',
                  enable_filtering: section.settings.enable_filtering,
                  enable_sorting: section.settings.enable_sorting
                %}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</collection-facets>

{% schema %}
{
  "name": "Search results",
  "tag": "div",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Results per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Show filters",
      "info": "Set up filters with the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Show sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show maker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "info": "A + button on the image. Adds products without options to the cart.",
      "default": true
    }
  ]
}
{% endschema %}
