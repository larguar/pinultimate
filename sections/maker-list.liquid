{%- comment -%}
  Lists every collection whose "Makers" metafield (custom.makers) is filled in.
  Rebuilt from the agency's maker list section.
{%- endcomment -%}
{%- liquid
  assign maker_count = 0
  for collection in collections
    if collection.metafields.custom.makers != blank
      assign maker_count = maker_count | plus: 1
    endif
  endfor
  assign heading = section.settings.heading | replace: '{count}', maker_count

  case section.settings.columns_desktop
    when '4'
      assign cols = 'row-cols-2 row-cols-sm-3 row-cols-md-4'
      assign sizes = '(min-width: 1360px) 316px, (min-width: 768px) 23vw, (min-width: 576px) 31vw, 46vw'
    when '5'
      assign cols = 'row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5'
      assign sizes = '(min-width: 1360px) 252px, (min-width: 992px) 18vw, (min-width: 768px) 23vw, (min-width: 576px) 31vw, 46vw'
    else
      assign cols = 'row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6'
      assign sizes = '(min-width: 1360px) 210px, (min-width: 992px) 15vw, (min-width: 768px) 23vw, (min-width: 576px) 31vw, 46vw'
  endcase
-%}

{{ 'section-main-list-collections.css' | asset_url | stylesheet_tag }}
{{ 'section-maker-list.css' | asset_url | stylesheet_tag }}

<section class="maker-list container-fluid px-0{% if section.settings.compact_spacing %} maker-list--compact{% else %} {% render 'section-spacing' %}{% endif %}">
  <div class="container">
    {%- if heading != blank or section.settings.subheading != blank -%}
      <div class="inline-heading d-flex align-items-center">
        {%- if heading != blank -%}
          <h2 class="inline-heading__title mb-0">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="inline-heading__subheading mb-0">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="maker-list__grid row {{ cols }}">
      {%- assign index = 0 -%}
      {%- for collection in collections -%}
        {%- if collection.metafields.custom.makers == blank -%}{%- continue -%}{%- endif -%}
        {%- assign index = index | plus: 1 -%}
        {%- assign lazy = true -%}
        {%- if index <= 6 -%}{%- assign lazy = false -%}{%- endif -%}
        <div class="col">
          {% render 'main-list-collections-item',
            collection: collection,
            ratio: section.settings.image_ratio,
            sizes: sizes,
            index: index,
            lazy: lazy
          %}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="text-center mt-5">
        <a href="{{ routes.collections_url }}" class="btn btn-outline-dark btn-cta">{{ section.settings.view_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Maker list",
  "tag": "div",
  "class": "section-maker-list",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows every collection with the Makers metafield filled in."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "{count} is replaced with the number of makers.",
      "default": "{count} Makers"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "info": "Shown smaller, beside the heading.",
      "default": "+ counting"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "6"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4x3", "label": "Landscape (4:3)" },
        { "value": "1x1", "label": "Square" },
        { "value": "5x6", "label": "Portrait (5:6)" },
        { "value": "2x3", "label": "Tall (2:3)" }
      ],
      "default": "5x6"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all collections\" button",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all collections"
    },
    {
      "type": "checkbox",
      "id": "compact_spacing",
      "label": "Reduce space above",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Maker list"
    }
  ]
}
{% endschema %}
