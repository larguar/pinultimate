{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

<section class="main-page container-fluid px-0">
  <div class="container{% if section.settings.content_width == 'narrow' %} main-page__container--narrow{% endif %}">
    <div class="row">
      <div class="col-12">
        {%- if section.settings.show_title -%}
          <h1 class="main-page__title mb-3">{{ page.title | escape }}</h1>
        {%- endif -%}

        <div class="main-page__content rte">
          {{ page.content }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "tag": "div",
  "class": "section-main-page",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the page's title and the content written in Online Store > Pages. The section that follows sits closer to it, without its usual top spacing."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full" },
        { "value": "narrow", "label": "Narrow (easier to read)" }
      ],
      "default": "full"
    }
  ]
}
{% endschema %}
