{%- liquid
  assign date_format = 'theme.pages.blog.date_format' | t
  assign share_url = shop.url | append: article.url
  assign share_title = article.title | url_param_escape
-%}

{{ 'section-main-article.css' | asset_url | stylesheet_tag }}

<div class="main-article container-fluid px-0">
  {%- for block in section.blocks -%}
    {%- if block.type == 'featured_image' and article.image == blank -%}{%- continue -%}{%- endif -%}
    {%- if block.type == 'product' and block.settings.product == blank -%}{%- continue -%}{%- endif -%}
    <div class="main-article__block container" {{ block.shopify_attributes }}>
      <div class="row">
        <div class="col-12">
          {%- case block.type -%}
            {%- when 'title' -%}
              <header>
                <h1 class="main-article__title mb-3">{{ article.title | escape }}</h1>

                {%- if block.settings.show_date or block.settings.show_author or block.settings.show_comments or block.settings.show_tags and article.tags.size > 0 -%}
                  <div class="main-article__meta row gx-3 row-gap-2 align-items-center">
                    <div class="col-12 col-md-6">
                      <p class="article-card__meta mb-0">
                        {%- if block.settings.show_date -%}
                          <span>{{ article.published_at | time_tag: date_format }}</span>
                        {%- endif -%}
                        {%- if block.settings.show_author -%}
                          <span>{{ article.author | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.show_comments and blog.comments_enabled? -%}
                          <span><a class="text-reset" href="#comments">{{ 'theme.pages.blog.comments' | t: count: article.comments_count }}</a></span>
                        {%- endif -%}
                      </p>
                    </div>
                    {%- if block.settings.show_tags and article.tags.size > 0 -%}
                      <div class="col-12 col-md-6">
                        {% render 'main-article-tags', tags: article.tags, blog_url: blog.url, class: 'justify-content-md-end' %}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </header>

            {%- when 'featured_image' -%}
              {%- if article.image -%}
                {%- liquid
                  assign ratio_style = ''
                  if block.settings.aspect_ratio != 'natural'
                    assign ratio_style = 'aspect-ratio: ' | append: block.settings.aspect_ratio | append: ';'
                  endif
                -%}
                <div
                  class="main-article__image overflow-hidden"
                  style="{{ ratio_style }}{% if block.settings.image_radius > 0 %} border-radius: {{ block.settings.image_radius }}px;{% endif %}"
                >
                  {{
                    article.image
                    | image_url: width: 1680
                    | image_tag:
                      loading: 'eager',
                      fetchpriority: 'high',
                      sizes: '(min-width: 920px) 840px, calc(100vw - 30px)',
                      widths: '420, 560, 840, 1120, 1680',
                      alt: article.image.alt,
                      class: 'd-block w-100 h-100 object-fit-cover'
                  }}
                </div>
              {%- endif -%}

            {%- when 'content' -%}
              <div class="main-article__content rte">
                {{ article.content }}
              </div>

              {%- if block.settings.show_tags and article.tags.size > 0 -%}
                <div class="mt-3">
                  {% render 'main-article-tags', tags: article.tags, blog_url: blog.url %}
                </div>
              {%- endif -%}

              {%- if block.settings.show_back or block.settings.show_share -%}
                <hr class="main-article__separator main-article__separator--top">
                <div class="main-article__actions d-flex flex-wrap align-items-center justify-content-between gap-3">
                  {%- if block.settings.show_back -%}
                    <a href="{{ blog.url }}" class="main-article__back btn border-0 d-inline-flex align-items-center gap-3">
                      {% render 'icon', name: 'arrow-left' %}
                      <span>{{ 'theme.pages.article.back' | t }}</span>
                    </a>
                  {%- endif -%}

                  {%- if block.settings.show_share -%}
                    <ul class="main-article__share list-unstyled d-flex align-items-center gap-1 mb-0 ms-auto">
                      <li>
                        <a href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" class="main-article__share-link">
                          {% render 'icon', name: 'facebook' %}
                          <span class="visually-hidden">{{ 'theme.pages.article.share_facebook' | t }}</span>
                        </a>
                      </li>
                      <li>
                        <a href="https://twitter.com/intent/tweet?text={{ share_title }}&amp;url={{ share_url | url_encode }}" target="_blank" rel="noopener" class="main-article__share-link">
                          {% render 'icon', name: 'twitter-x' %}
                          <span class="visually-hidden">{{ 'theme.pages.article.share_x' | t }}</span>
                        </a>
                      </li>
                      <li>
                        <a href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&amp;media={% if article.image %}{{ article.image | image_url: width: 1024 | prepend: 'https:' | url_encode }}{% endif %}&amp;description={{ share_title }}" target="_blank" rel="noopener" class="main-article__share-link">
                          {% render 'icon', name: 'pinterest' %}
                          <span class="visually-hidden">{{ 'theme.pages.article.share_pinterest' | t }}</span>
                        </a>
                      </li>
                    </ul>
                  {%- endif -%}
                </div>
                <hr class="main-article__separator main-article__separator--bottom">
              {%- endif -%}

            {%- when 'product' -%}
              {%- assign product = block.settings.product -%}
              {%- if product != blank -%}
                <aside class="main-article__product p-4{% if block.settings.style == 'filled' %} bg-light{% else %} border{% endif %}">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="main-article__product-heading mb-3">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="row">
                    <div class="col-8 col-sm-5 col-md-4">
                      {% render 'product-card', product: product, sizes: '(min-width: 768px) 280px, 60vw', heading_tag: 'h3' %}
                    </div>
                  </div>
                </aside>
              {%- endif -%}
          {%- endcase -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Blog post",
  "tag": "article",
  "class": "section-main-article",
  "blocks": [
    {
      "type": "featured_image",
      "name": "Featured image",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Image shape",
          "options": [
            { "value": "natural", "label": "Original" },
            { "value": "4/3", "label": "Landscape (4:3)" },
            { "value": "1/1", "label": "Square" },
            { "value": "5/6", "label": "Portrait (5:6)" }
          ],
          "default": "natural"
        },
        {
          "type": "range",
          "id": "image_radius",
          "label": "Corner radius",
          "min": 0,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 0
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_date",
          "label": "Show date",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_author",
          "label": "Show author",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_comments",
          "label": "Show number of comments",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_tags",
          "label": "Show tags",
          "default": false
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_back",
          "label": "Show \"Back\" link",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_share",
          "label": "Show share links",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_tags",
          "label": "Show tags",
          "default": false
        }
      ]
    },
    {
      "type": "product",
      "name": "Recommended product",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Recommended product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Nothing shows until a product is chosen."
        },
        {
          "type": "select",
          "id": "style",
          "label": "Box style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "filled", "label": "Filled" }
          ],
          "default": "outline"
        }
      ]
    }
  ]
}
{% endschema %}
