{%- comment -%}
  Full-width image slides, each with an optional caption, title and button in a white box.
  Uses the theme's <swiper-slider>; src/js/sections/slideshow.js adds the pause button and
  stops autoplay for visitors who prefer reduced motion.
{%- endcomment -%}
{%- liquid
  assign slide_count = section.blocks.size
  assign autoplay = false
  if section.settings.autoplay and slide_count > 1
    assign autoplay = true
  endif

  if section.settings.full_width
    assign container = 'container-fluid px-0'
    assign sizes = '100vw'
  else
    assign container = 'container'
    assign sizes = '(min-width: 1400px) 1360px, 100vw'
  endif

  case section.settings.text_position
    when 'top-left'
      assign position_class = 'justify-content-start align-items-start'
    when 'top-center'
      assign position_class = 'justify-content-center align-items-start text-center'
    when 'top-right'
      assign position_class = 'justify-content-end align-items-start'
    when 'middle-left'
      assign position_class = 'justify-content-start align-items-center'
    when 'middle-center'
      assign position_class = 'justify-content-center align-items-center text-center'
    when 'middle-right'
      assign position_class = 'justify-content-end align-items-center'
    when 'bottom-center'
      assign position_class = 'justify-content-center align-items-end text-center'
    when 'bottom-right'
      assign position_class = 'justify-content-end align-items-end'
    else
      assign position_class = 'justify-content-start align-items-end'
  endcase
-%}

{%- if slide_count > 0 -%}
  {{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'section-slideshow.js' | asset_url }}" defer="defer"></script>

  <section
    class="slideshow container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}"
    aria-roledescription="carousel"
    aria-label="{{ 'theme.hero.slideshow_label' | t }}"
  >
    <div class="{{ container }}">
      <div class="row g-0">
        <div class="col-12">
          <swiper-slider
            class="slideshow__slider d-block position-relative slideshow--{{ section.settings.height }} slideshow--mobile-{{ section.settings.height_mobile }}"
            data-options='{
              "loop": {{ autoplay }},
              "speed": 600,
              "autoHeight": {% if section.settings.height == 'adapt' %}true{% else %}false{% endif %}
              {%- if autoplay -%}
                , "autoplay": { "delay": {{ section.settings.autoplay_interval | times: 1000 }}, "pauseOnMouseEnter": true, "disableOnInteraction": false }
              {%- endif -%}
            }'
          >
            <div class="swiper">
              <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign fetchpriority = 'auto'
                    if section.index <= 2 and forloop.first
                      assign loading = 'eager'
                      assign fetchpriority = 'high'
                    endif
                    assign image = block.settings.image
                    assign mobile_image = block.settings.mobile_image | default: image
                    assign has_text = false
                    if block.settings.caption != blank or block.settings.title != blank or block.settings.button_label != blank
                      assign has_text = true
                    endif
                  -%}
                  <div
                    class="swiper-slide slideshow__slide position-relative overflow-hidden"
                    role="group"
                    aria-roledescription="slide"
                    aria-label="{{ 'theme.hero.slide_label' | t: index: forloop.index, count: slide_count }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="slideshow__media{% if section.settings.height != 'adapt' %} position-absolute top-0 start-0 w-100 h-100{% endif %}">
                      {%- if image != blank -%}
                        <picture>
                          {%- if block.settings.mobile_image != blank -%}
                            <source
                              media="(max-width: 767px)"
                              srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
                              sizes="100vw"
                            >
                          {%- endif -%}
                          {{
                            image
                            | image_url: width: 2400
                            | image_tag:
                              widths: '375, 750, 1100, 1500, 1800, 2400',
                              sizes: sizes,
                              loading: loading,
                              fetchpriority: fetchpriority,
                              alt: image.alt,
                              class: 'd-block w-100 h-100 object-fit-cover'
                          }}
                        </picture>
                      {%- else -%}
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'd-block w-100 h-100 bg-light' }}
                      {%- endif -%}
                      {%- if block.settings.overlay > 0 -%}
                        <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark" style="opacity: {{ block.settings.overlay | divided_by: 100.0 }};"></div>
                      {%- endif -%}
                    </div>

                    {%- if has_text -%}
                      <div class="slideshow__content{% if section.settings.height == 'adapt' %} position-absolute top-0 start-0 w-100 h-100{% else %} position-relative h-100{% endif %}">
                        <div class="container h-100 d-flex {{ position_class }} py-4 py-md-5">
                          <div class="slideshow__box{% if section.settings.text_box %} bg-white{% else %} text-white{% endif %}">
                            {%- if block.settings.caption != blank -%}
                              <p class="slideshow__caption mb-2 mb-md-3">{{ block.settings.caption | escape }}</p>
                            {%- endif -%}
                            {%- if block.settings.title != blank -%}
                              <h2 class="slideshow__title">
                                {%- if block.settings.button_label == blank and block.settings.link != blank -%}
                                  <a href="{{ block.settings.link }}" class="text-reset"{% if block.settings.open_in_new_window %} target="_blank" rel="noopener"{% endif %}>
                                    {{- block.settings.title | escape -}}
                                  </a>
                                {%- else -%}
                                  {{- block.settings.title | escape -}}
                                {%- endif -%}
                              </h2>
                            {%- endif -%}
                            {%- if block.settings.button_label != blank -%}
                              <a
                                {% if block.settings.link != blank %}
                                  href="{{ block.settings.link }}"
                                {% else %}
                                  role="link" aria-disabled="true"
                                {% endif %}
                                class="btn btn-primary btn-cta"
                                {% if block.settings.open_in_new_window %}
                                  target="_blank" rel="noopener"
                                {% endif %}
                              >
                                {{- block.settings.button_label | escape -}}
                              </a>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            </div>

            {%- if slide_count > 1 -%}
              <div class="slideshow__controls position-absolute bottom-0 end-0 d-flex align-items-center gap-2 p-3">
                <div class="swiper-pagination position-static w-auto"></div>
                {%- if autoplay -%}
                  <slideshow-pause>
                    <button
                      type="button"
                      class="slideshow__pause btn btn-light rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                      aria-label="{{ 'theme.hero.pause' | t }}"
                      data-label-pause="{{ 'theme.hero.pause' | t }}"
                      data-label-play="{{ 'theme.hero.play' | t }}"
                    >
                      <svg class="slideshow__icon-pause" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5m5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5"/></svg>
                      <svg class="slideshow__icon-play" width="12" height="12" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"/></svg>
                    </button>
                  </slideshow-pause>
                {%- endif -%}
              </div>
            {%- endif -%}
          </swiper-slider>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Slideshow",
  "tag": "div",
  "class": "section-slideshow",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Change slides automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Time per slide",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "checkbox",
      "id": "text_box",
      "label": "Show text in a white box",
      "info": "Otherwise the text is white, straight on the image.",
      "default": true
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height on desktop",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "40", "label": "40% of the screen" },
        { "value": "50", "label": "50% of the screen" },
        { "value": "60", "label": "60% of the screen" },
        { "value": "80", "label": "80% of the screen" },
        { "value": "100", "label": "Full screen" }
      ],
      "default": "60"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Height on mobile and tablet",
      "info": "Ignored when the desktop height adapts to the image.",
      "options": [
        { "value": "40", "label": "40% of the screen" },
        { "value": "50", "label": "50% of the screen" },
        { "value": "60", "label": "60% of the screen" },
        { "value": "80", "label": "80% of the screen" },
        { "value": "100", "label": "Full screen" }
      ],
      "default": "60"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Shown on phones instead of the image."
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Darken image",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Small uppercase text above the title.",
          "default": "Introducing"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Your best promotion yet"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "info": "Leave blank to link the title instead.",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_window",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
