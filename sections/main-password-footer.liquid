{%- comment -%}
  Password page footer: copyright, and either "Powered by Shopify" or the social links.
{%- endcomment -%}
<footer class="main-password-footer container-fluid px-0 border-top">
  <div class="container">
    <div class="row align-items-center justify-content-between g-3 py-4 small">
      <div class="col-12 col-md-auto text-center text-md-start">
        &copy; {{ 'now' | date: '%Y' }}
        <a href="{{ routes.root_url }}" class="text-reset">{{ shop.name | escape }}</a>.
        {% if section.settings.show_social %}<span class="ms-1">{{ powered_by_link }}</span>{% endif %}
      </div>
      <div class="col-12 col-md-auto d-flex justify-content-center">
        {%- if section.settings.show_social -%}
          {% render 'social-icons', class: 'gap-3' %}
        {%- else -%}
          <span>{{ powered_by_link }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Password footer",
  "class": "section-main-password-footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media links",
      "info": "Links are set in Theme settings > Social media.",
      "default": false
    }
  ]
}
{% endschema %}
