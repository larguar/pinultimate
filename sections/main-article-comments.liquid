{%- if blog.comments_enabled? -%}
  {%- assign date_format = 'theme.pages.blog.date_format' | t -%}
  {{ 'section-main-article-comments.css' | asset_url | stylesheet_tag }}

  <section id="comments" class="main-article-comments container-fluid px-0" aria-labelledby="CommentsHeading-{{ section.id }}">
    <div class="container main-article-comments__container">
      <h2 id="CommentsHeading-{{ section.id }}" class="main-article-comments__heading mb-3">
        {{- 'theme.pages.article.comments_heading' | t }} ({{ article.comments_count -}})
      </h2>

      {%- paginate article.comments by 10 -%}
        {%- if article.comments_count > 0 -%}
          <ul class="list-unstyled d-grid gap-3 mb-0">
            {%- for comment in article.comments -%}
              <li id="{{ comment.id }}" class="main-article-comments__comment p-4 rounded{% if section.settings.style == 'filled' %} bg-light{% else %} border{% endif %}">
                <div class="rte mb-3">{{ comment.content }}</div>
                <p class="d-flex flex-wrap align-items-baseline gap-2 mb-0">
                  <span class="fw-semibold">{{ comment.author | escape }}</span>
                  <span class="article-card__meta">{{ comment.created_at | time_tag: date_format }}</span>
                </p>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'main-blog-pagination', paginate: paginate, anchor: '#comments' %}
        {%- else -%}
          <p class="mb-0">{{ 'theme.pages.article.no_comments' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article, id: 'CommentForm', class: 'main-article-comments__form mt-5' -%}
        {%- liquid
          assign post_message = 'theme.pages.article.success'
          if blog.moderated?
            assign post_message = 'theme.pages.article.success_moderated'
          endif
        -%}
        <h2 class="main-article-comments__heading mb-3">{{ 'theme.pages.article.form_heading' | t }}</h2>

        {%- if form.posted_successfully? -%}
          <div class="alert alert-success d-flex align-items-center gap-2" role="status" tabindex="-1" autofocus>
            {% render 'icon', name: 'check-circle', class: 'flex-shrink-0' %}
            <span>{{ post_message | t }}</span>
          </div>
        {%- elsif form.errors -%}
          <div id="CommentForm-errors" class="alert alert-danger" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="visually-hidden" for="CommentForm-author">{{ 'theme.pages.article.name' | t }}</label>
            <input
              type="text"
              id="CommentForm-author"
              class="form-control{% if form.errors contains 'author' %} is-invalid{% endif %}"
              name="comment[author]"
              autocomplete="name"
              value="{{ form.author }}"
              placeholder="{{ 'theme.pages.article.name' | t }}"
              required
              {% if form.errors contains 'author' %}
                aria-invalid="true" aria-describedby="CommentForm-errors"
              {% endif %}
            >
          </div>
          <div class="col-12 col-md-6">
            <label class="visually-hidden" for="CommentForm-email">{{ 'theme.pages.article.email' | t }}</label>
            <input
              type="email"
              id="CommentForm-email"
              class="form-control{% if form.errors contains 'email' %} is-invalid{% endif %}"
              name="comment[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{{ form.email }}"
              placeholder="{{ 'theme.pages.article.email' | t }}"
              required
              {% if form.errors contains 'email' %}
                aria-invalid="true" aria-describedby="CommentForm-errors"
              {% endif %}
            >
          </div>
          <div class="col-12">
            <label class="visually-hidden" for="CommentForm-body">{{ 'theme.pages.article.message' | t }}</label>
            <textarea
              id="CommentForm-body"
              class="form-control{% if form.errors contains 'body' %} is-invalid{% endif %}"
              name="comment[body]"
              rows="6"
              placeholder="{{ 'theme.pages.article.message' | t }}"
              required
              {% if form.errors contains 'body' %}
                aria-invalid="true" aria-describedby="CommentForm-errors"
              {% endif %}
            >{{- form.body -}}</textarea>
          </div>
          <div class="col-12">
            <button type="submit" class="btn btn-outline-dark">{{ 'theme.pages.article.post' | t }}</button>
          </div>
          {%- if blog.moderated? -%}
            <div class="col-12">
              <p class="small fst-italic mb-0">{{ 'theme.pages.article.moderated' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Blog post comments",
  "tag": "div",
  "class": "section-main-article-comments",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown only when comments are turned on for the blog (Online Store > Blog posts > Manage blogs)."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Comment style",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "filled"
    }
  ]
}
{% endschema %}
