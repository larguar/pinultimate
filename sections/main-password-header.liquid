{%- comment -%}
  Password page header: the logo, and a button that opens the store password form.
{%- endcomment -%}
{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

<header class="main-password-header container-fluid px-0 border-bottom">
  <div class="container">
    <div class="row flex-nowrap align-items-center justify-content-between g-3 py-3 py-lg-4">
      <div class="col-auto">
        <a href="{{ routes.root_url }}" class="d-block">
          {%- if settings.logo != blank -%}
            {%- liquid
              assign logo_mobile = settings.logo_mobile | default: settings.logo
              assign logo_width = settings.logo.aspect_ratio | times: settings.logo_height | ceil
              assign logo_width_2x = logo_width | times: 2
            -%}
            <picture>
              <source
                media="(min-width: 768px)"
                srcset="{{ settings.logo | image_url: width: logo_width }} 1x, {{ settings.logo | image_url: width: logo_width_2x }} 2x"
              >
              {{
                logo_mobile
                | image_url: width: 500
                | image_tag: class: 'site-header__logo-image', alt: shop.name, loading: 'eager', widths: '200, 300, 500'
              }}
            </picture>
          {%- else -%}
            <span class="h3">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="col-auto">
        <button
          type="button"
          class="btn btn-link p-0 text-reset text-decoration-none d-inline-flex align-items-center gap-2 main-password-header__login"
          data-bs-toggle="modal"
          data-bs-target="#main-password-modal"
        >
          <span class="d-none d-sm-inline">{{ 'theme.utility.password.enter_with_password' | t }}</span>
          <span class="visually-hidden d-sm-none">{{ 'theme.utility.password.enter_with_password' | t }}</span>
          {%- render 'icon', name: 'lock' -%}
        </button>
      </div>
    </div>
  </div>
</header>

<div
  class="modal fade main-password-modal"
  id="main-password-modal"
  tabindex="-1"
  aria-labelledby="main-password-modal-title"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-0 p-3 p-md-4">
      <div class="modal-header border-0 p-0 mb-3">
        <h2 class="modal-title h5 fw-semibold" id="main-password-modal-title">
          {{- 'theme.utility.password.login_heading' | t -}}
        </h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'accessibility.close' | t }}"></button>
      </div>
      <div class="modal-body p-0">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <div class="alert alert-danger py-2" role="alert" id="main-password-error">
              {{- 'theme.utility.password.error' | t -}}
            </div>
          {%- endif -%}
          <label for="main-password-input" class="form-label">{{ 'theme.utility.password.password_label' | t }}</label>
          <input
            type="password"
            name="password"
            id="main-password-input"
            class="form-control form-control-lg{% if form.errors %} is-invalid{% endif %}"
            placeholder="{{ 'theme.utility.password.password_placeholder' | t }}"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="main-password-error"
            {% endif %}
          >
          <button type="submit" name="commit" class="btn btn-dark w-100 mt-3">
            {{- 'theme.utility.password.submit' | t -}}
          </button>
        {%- endform -%}
        <p class="small text-body-secondary mt-3 mb-0 main-password-modal__admin">
          {{- 'theme.utility.password.admin_link_html' | t -}}
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // Reopen the password form after a wrong password, so the error is visible.
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('main-password-modal');
    if (modal && modal.querySelector('#main-password-error') && window.bootstrap) window.bootstrap.Modal.getOrCreateInstance(modal).show();
  });
</script>

{% schema %}
{
  "name": "Password header",
  "class": "section-main-password-header",
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses the logo from Theme settings > Logo."
    }
  ]
}
{% endschema %}
