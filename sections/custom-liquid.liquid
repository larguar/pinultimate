{%- liquid
  assign full_width = section.settings.full_width
  assign heading_class = 'mb-4'
  if section.settings.heading_alignment == 'center'
    assign heading_class = 'text-center mb-4'
  endif

  assign background_class = ''
  if section.settings.background != 'none'
    assign background_class = 'bg-' | append: section.settings.background
  endif
-%}

{{ 'section-custom-liquid.css' | asset_url | stylesheet_tag }}

<section class="custom-liquid{% if full_width %} custom-liquid--full-width{% endif %} container-fluid px-0 {{ background_class }} {% if section.settings.background != 'none' %}{% render 'section-spacing', property: 'p', side: 'y', size: section.settings.spacing %}{% else %}{% render 'section-spacing', size: section.settings.spacing %}{% endif %}">
  {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.button_label != blank -%}
    <div class="container">
      {% render 'section-heading',
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: section.settings.heading_tag,
        class: heading_class
      %}
      {%- if section.settings.button_label != blank -%}
        <div class="{% if section.settings.heading_alignment == 'center' %}text-center {% endif %}mb-4">
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="btn btn-outline-dark btn-cta"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="{% if full_width %}container-fluid px-0{% else %}container{% endif %}">
    <div class="row{% if full_width %} g-0{% endif %}">
      <div class="custom-liquid__content col-12">
        {{ section.settings.custom_liquid }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "div",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Liquid code",
      "info": "Add app snippets, embeds or other code. Headings and paragraphs pick up the theme's text styles."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Shown in the script font above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level (for search engines)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Lets the code fill the whole width of the screen, edge to edge.",
      "default": false
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "info": "Directly after the page content, the top spacing is removed.",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}
