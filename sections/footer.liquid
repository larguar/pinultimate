<footer class="site-footer position-relative">
  {%- if section.settings.show_paper_edge -%}
    <div class="site-footer__paper text-primary">{% render 'footer-paper' %}</div>
  {%- endif -%}

  <div class="site-footer__body bg-primary text-white position-relative" data-bs-theme="dark">
    {%- if section.settings.signup_heading != blank or section.settings.klaviyo_form_id != blank -%}
      <div class="container">
        <div class="site-footer__signup text-center mx-auto">
          {%- if section.settings.signup_heading != blank -%}
            <h2 class="site-footer__signup-heading fst-italic fw-medium">{{ section.settings.signup_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.signup_text != blank -%}
            <div class="site-footer__signup-text">{{ section.settings.signup_text }}</div>
          {%- endif -%}
          {%- if section.settings.klaviyo_form_id != blank -%}
            <div class="site-footer__signup-form bg-secondary">
              <div class="klaviyo-form-{{ section.settings.klaviyo_form_id | escape }}"></div>
            </div>
          {%- endif -%}
          {%- if section.settings.signup_legal != blank -%}
            <div class="site-footer__legal">{{ section.settings.signup_legal }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="container site-footer__top">
        <div class="row flex-lg-nowrap gy-4">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'text' -%}
                <div class="col-12 col-lg-auto site-footer__block site-footer__block--text" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="site-footer__heading{% if block.settings.heading_accent %} site-footer__heading--accent text-yellow{% endif %}">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <div class="site-footer__text">{{ block.settings.text }}</div>
                </div>
              {%- when 'menu' -%}
                <div class="col-6 col-md site-footer__block" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <ul class="list-unstyled mb-0">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}" class="site-footer__link">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="site-footer__bottom border-top">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-12 col-md-6 col-lg order-1 order-lg-3 d-flex justify-content-md-end site-footer__social">
            {% render 'social-icons' %}
          </div>
          <div class="col-12 col-md-6 col-lg order-2 order-lg-1 d-flex align-items-center site-footer__legal-links">
            {%- if section.settings.show_localization -%}
              {% render 'localization-dropdown', id: 'FooterLocalization', direction: 'up' %}
            {%- endif -%}
            {%- if shop.terms_of_service -%}
              <a href="{{ shop.terms_of_service.url }}" class="site-footer__link site-footer__policy text-center">{{ 'theme.footer.terms' | t }}</a>
            {%- endif -%}
            {%- if shop.privacy_policy -%}
              <a href="{{ shop.privacy_policy.url }}" class="site-footer__link site-footer__policy text-center">{{ 'theme.footer.privacy' | t }}</a>
            {%- endif -%}
          </div>
          <div class="col-12 col-lg-auto order-3 order-lg-2 site-footer__copyright">
            &copy; {% if section.settings.copyright_start_year != blank %}{{ section.settings.copyright_start_year }}–{% endif %}{{ 'now' | date: '%Y' }}
            {{ section.settings.copyright_name | default: shop.name | escape }}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_paper_edge",
      "label": "Show torn paper top edge",
      "default": true
    },
    {
      "type": "header",
      "content": "Email signup"
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Heading",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "richtext",
      "id": "signup_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo form ID",
      "info": "The embedded form's ID from Klaviyo, e.g. RGmBAq."
    },
    {
      "type": "richtext",
      "id": "signup_legal",
      "label": "Fine print"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country/currency selector",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_start_year",
      "label": "Copyright start year",
      "default": "2018"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name",
      "info": "Defaults to the store name."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "checkbox",
          "id": "heading_accent",
          "label": "Use accent color for heading",
          "default": false
        },
        {
          "type": "html",
          "id": "text",
          "label": "Content",
          "info": "HTML is allowed, so app widgets such as review badges can be embedded."
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
