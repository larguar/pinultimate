{% style %}
.bounce-container .bounce-background {
  height: {{ section.settings.desktop_height }};
  width: 100%;
  position: relative;
  overflow: hidden;
}
.bounce-background .card__image {
  display: flex;
}
.bounce-background .card__image .lazy-image.lazy-image--background {
  position: relative;
}
.bounce {
  font-size: {{ section.settings.font_size }}px;
  line-height: 0.9;
  letter-spacing: -0.5px;
  font-style: italic;
  font-weight: 600!important;
  text-transform: {{ section.settings.text_transform }};
  color: {{ section.settings.color_text_main }};
  /* background: yellow; */
  width: {{ section.settings.text_width }}px;
  height: {{ section.settings.text_height }}px;
  margin: 0px;
  padding: 0px;
  position: relative;
  display: block;
  position: absolute;
  z-index: 1;
  -webkit-animation: moveX {{ section.settings.bounce_interval }}.05s ease-in 0s infinite alternate, moveY {{ section.settings.bounce_interval }}.4s ease-in 0s infinite alternate;
  -moz-animation: moveX {{ section.settings.bounce_interval }}.05s ease-in 0s infinite alternate, moveY {{ section.settings.bounce_interval }}.4s ease-in 0s infinite alternate;
  -o-animation: moveX {{ section.settings.bounce_interval }}.05s ease-in 0s infinite alternate, moveY {{ section.settings.bounce_interval }}.4s ease-in 0s infinite alternate;
  animation: moveX {{ section.settings.bounce_interval }}.05s ease-in 0s infinite alternate, moveY {{ section.settings.bounce_interval }}.4s ease-in 0s infinite alternate;
}
.bounce span {
  position: relative;
  left: {{ section.settings.span_left }}px;
  top: {{ section.settings.span_top }}px;
}
.bounce-container .button-container {
  position: absolute;
  bottom: 0;
  z-index: 2;
  width: 100%;
  text-align: center;
  padding: 100px 0;
}
@-webkit-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.text_width }}px); }}
@-moz-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.text_width }}px); }}
@-o-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.text_width }}px); }}
@keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.text_width }}px); }}
@-webkit-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.text_height }}px); }}
@-moz-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.text_height }}px); }}
@-o-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.text_height }}px); }}
@keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.text_height }}px); }}

@media screen and (max-width: 1023px) {
  .bounce-container > .bounce-background {
    height: {{ section.settings.mobile_height }};
  }
}
@media screen and (max-width: 767px) {
  .bounce-background .card__image figure.lazy-image:nth-of-type(2), .bounce-background .card__image figure.lazy-image:nth-of-type(3) {
    display: none;
  }
  .bounce {
    font-size: {{ section.settings.mobile_font_size }}px;
    width: {{ section.settings.mobile_text_width }}px;
    height: {{ section.settings.mobile_text_height }}px;
  }
  .bounce span {
    left: {{ section.settings.mobile_span_left }}px;
    top: {{ section.settings.mobile_span_top }}px;
  }
  .bounce-container .button-container {
    padding: 80px 0;
  }
  @-webkit-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.mobile_text_width }}px); }}
  @-moz-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.mobile_text_width }}px); }}
  @-o-keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.mobile_text_width }}px); }}
  @keyframes moveX {from { left: 0; } to { left: calc(100% - {{ section.settings.mobile_text_width }}px); }}
  @-webkit-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.mobile_text_height }}px); }}
  @-moz-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.mobile_text_height }}px); }}
  @-o-keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.mobile_text_height }}px); }}
  @keyframes moveY {from { top: 0; } to { top: calc(100% - {{ section.settings.mobile_text_height }}px); }}
}


{% endstyle %}



  {% style %}
    #bounce-{{ section.id }} .card {
      height: {{ section.settings.desktop_height }};
      min-height: 450px;
    }
    @media all and (max-width: 1023px) {
      #bounce-{{ section.id }} .card {
        height: {{ section.settings.mobile_height }};
      }
    }
  {% endstyle %}

  <div id="bounce-{{ section.id }}" class="bounce-container {% if section.settings.is_fullwidth %} container--fullwidth {% else %} container--large {% endif %} {% unless section.settings.remove_margin %} container--vertical-space {% endunless %} remove-empty-space">
    <div class="grid {%- if section.settings.is_fullwidth %} grid--gap-none {% else %} grid--gap-small {% endif %}">
      <div class="bounce-background card card--fullwidth {% if section.settings.is_fullwidth %} card--no-radius {% endif %} card--no-borders" {{ block.shopify_attributes }}>

        <h1 class="bounce"><span>{{ section.settings.title }}</span></h1>

        {%- if section.settings.button_label != blank -%}
          <div class="button-container" data-aos="fade-up">
            {%- render 'button', target_blank: section.settings.open_in_new_window, label: section.settings.button_label, link: section.settings.link, style: section.settings.button_style, fullwidth: false -%}
          </div>
        {%- endif -%}

        {%- liquid
          if section.index == 1 and forloop.first
            assign preload = true
          else
            assign preload = false
          endif
        -%}
        <div class="card__image card__image--background" aria-hidden="true">
          
          {%- unless section.settings.image == blank -%} 
            {%- liquid
              assign image_type = 'background'
              assign image_alignment = true
            -%}
            {%- capture sizes -%}
              sizes="(max-width: 1023px) calc({{ section.settings.mobile_height }} * {{ section.settings.image.aspect_ratio }}), calc({{ section.settings.desktop_height }} * {{ section.settings.image.aspect_ratio }})"
            {%- endcapture -%}
            {%- render 'lazy-image', image: section.settings.image, type: image_type, alt: section.settings.title, image_alignment: image_alignment, sizes: sizes, class: image_class, overlay: true, preload: preload -%}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endunless -%}

          {%- unless section.settings.image2 == blank -%} 
            {%- liquid
              assign image_type = 'background'
              assign image_alignment = true
            -%}
            {%- capture sizes -%}
              sizes="(max-width: 1023px) calc({{ section.settings.mobile_height }} * {{ section.settings.image2.aspect_ratio }}), calc({{ section.settings.desktop_height }} * {{ section.settings.image2.aspect_ratio }})"
            {%- endcapture -%}
            {%- render 'lazy-image', image: section.settings.image2, type: image_type, alt: section.settings.title, image_alignment: image_alignment, sizes: sizes, class: image_class, overlay: true, preload: preload -%}
          {%- endunless -%}

          {%- unless section.settings.image3 == blank -%} 
            {%- liquid
              assign image_type = 'background'
              assign image_alignment = true
            -%}
            {%- capture sizes -%}
              sizes="(max-width: 1023px) calc({{ section.settings.mobile_height }} * {{ section.settings.image3.aspect_ratio }}), calc({{ section.settings.desktop_height }} * {{ section.settings.image3.aspect_ratio }})"
            {%- endcapture -%}
            {%- render 'lazy-image', image: section.settings.image3, type: image_type, alt: section.settings.title, image_alignment: image_alignment, sizes: sizes, class: image_class, overlay: true, preload: preload -%}
          {%- endunless -%}
          
        </div>
        
      </div>
    </div>
  </div>

