{%- liquid
  assign menu = section.settings.menu
  assign logo_tag = 'div'
  if request.page_type == 'index'
    assign logo_tag = 'h1'
  endif
-%}

<sticky-header class="site-header d-block bg-white" {% unless section.settings.sticky %}data-disabled{% endunless %}>
  <div class="container-fluid px-0">
    <div class="container">
      <div class="row align-items-center site-header__top">
        <div class="col">
          <button
            type="button"
            class="site-header__icon btn btn-link p-0 text-dark"
            data-bs-toggle="offcanvas"
            data-bs-target="#search-drawer"
            aria-controls="search-drawer"
          >
            {%- render 'icon', name: 'search' -%}
            <span class="visually-hidden">{{ 'theme.header.open_search' | t }}</span>
          </button>
        </div>

        <div class="col-auto">
          <{{ logo_tag }} class="site-header__logo m-0 lh-1">
            <a href="{{ routes.root_url }}" class="d-block">
              {%- if settings.logo != blank -%}
                {%- liquid
                  assign logo_mobile = settings.logo_mobile | default: settings.logo
                  assign logo_width = settings.logo.aspect_ratio | times: settings.logo_height | ceil
                -%}
                <picture>
                  <source
                    media="(min-width: 768px)"
                    srcset="{{ settings.logo | image_url: width: logo_width }} 1x, {{ settings.logo | image_url: width: logo_width | times: 2 }} 2x"
                  >
                  {{
                    logo_mobile
                    | image_url: width: 500
                    | image_tag: class: 'site-header__logo-image', alt: shop.name, loading: 'eager', widths: '200, 300, 500'
                  }}
                </picture>
              {%- else -%}
                <span class="h3">{{ shop.name }}</span>
              {%- endif -%}
            </a>
          </{{ logo_tag }}>
        </div>

        <div class="col d-flex justify-content-end align-items-center gap-3 gap-lg-4">
          {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
            <a href="{{ routes.account_url }}" class="site-header__icon d-none d-lg-block text-dark">
              {%- render 'icon', name: 'account' -%}
              <span class="visually-hidden">{{ 'theme.header.account' | t }}</span>
            </a>
          {%- endif -%}

          <a
            href="{{ routes.cart_url }}"
            class="site-header__icon site-header__cart position-relative text-dark"
            {% if settings.cart_type == 'drawer' %}
              role="button"
              data-bs-toggle="offcanvas"
              data-bs-target="#cart-drawer"
              aria-controls="cart-drawer"
            {% endif %}
          >
            {%- render 'icon', name: 'cart' -%}
            <span class="site-header__cart-count position-absolute d-flex align-items-center justify-content-center rounded-circle bg-purple text-dark fw-semibold" data-cart-count aria-hidden="true">
              {{- cart.item_count -}}
            </span>
            <span class="visually-hidden">{{ 'theme.header.cart_count' | t: count: cart.item_count }}</span>
          </a>

          <button
            type="button"
            class="site-header__icon btn btn-link p-0 text-dark d-lg-none"
            data-bs-toggle="offcanvas"
            data-bs-target="#menu-drawer"
            aria-controls="menu-drawer"
          >
            {%- render 'icon', name: 'list' -%}
            <span class="visually-hidden">{{ 'theme.header.open_menu' | t }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <nav class="site-nav container-fluid px-0 d-none d-lg-block border-top" aria-label="{{ 'sections.header.menu' | t }}">
      <div class="container">
        <ul class="nav justify-content-center">
          {%- for link in menu.links -%}
            <li class="nav-item{% if link.links.size > 0 %} site-nav__dropdown position-relative{% endif %}">
              <a
                href="{{ link.url }}"
                class="nav-link site-nav__link{% if link.active %} active{% endif %}"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="site-nav__submenu list-unstyled position-absolute start-50 translate-middle-x bg-white shadow-sm py-3 mb-0">
                  {%- for child in link.links -%}
                    <li>
                      <a
                        href="{{ child.url }}"
                        class="d-block px-4 py-1 text-nowrap"
                        {% if child.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- child.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>
  {%- endif -%}
</sticky-header>

{% render 'search-drawer' %}
{% render 'menu-drawer', menu: menu, show_account: section.settings.show_account %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Show header when scrolling up",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account link",
      "default": true
    }
  ]
}
{% endschema %}
