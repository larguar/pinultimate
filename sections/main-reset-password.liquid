{%- comment -%}
  Classic customer accounts: choose a new password from the reset email link.
  Based on Dawn's main-reset-password (Shopify, MIT), restyled with Bootstrap.
{%- endcomment -%}
{{ 'section-main-account.css' | asset_url | stylesheet_tag }}

<section class="customer customer--reset container-fluid px-0">
  <div class="container customer__container customer__container--narrow">
    <h1 class="customer__title">{{ 'theme.utility.account.reset_title' | t }}</h1>
    <div class="customer__body">
      {%- form 'reset_customer_password' -%}
        <p>{{ 'theme.utility.account.reset_text' | t: email: form.email }}</p>

        {%- if form.errors -%}
          <div class="alert alert-danger" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="mb-3">
          <label for="ResetPassword" class="form-label">{{ 'theme.utility.account.password' | t }}</label>
          <input
            type="password"
            name="customer[password]"
            id="ResetPassword"
            class="form-control{% if form.errors contains 'password' %} is-invalid{% endif %}"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>
        <div class="mb-4">
          <label for="ResetPasswordConfirmation" class="form-label">{{ 'theme.utility.account.password_confirm' | t }}</label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="ResetPasswordConfirmation"
            class="form-control{% if form.errors contains 'password_confirmation' %} is-invalid{% endif %}"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password_confirmation' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <button type="submit" class="btn btn-dark">{{ 'theme.utility.account.reset_submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "tag": "div",
  "class": "section-main-reset-password",
  "settings": []
}
{% endschema %}
