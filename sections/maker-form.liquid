{%- comment -%}
  Maker application. Answers go to the Google Form set in the section settings, not to the
  store's email. The field names are that form's question ids (entry.<id>); if the Google Form's
  questions change, update them here.
{%- endcomment -%}
{%- liquid
  assign form_id = 'MakerForm-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign form_url = section.settings.form_url | strip
-%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'section-maker-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-maker-form.js' | asset_url }}" defer="defer"></script>

<section class="maker-form contact-form container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="contact-form__heading{% if section.settings.heading_style == 'italic' %} fst-italic{% endif %}">
            {{- section.settings.heading | escape -}}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- if form_url contains 'docs.google.com/forms/' -%}
          <maker-form>
            <div class="alert alert-success mb-3" role="status" tabindex="-1" hidden data-maker-form-success>
              <div class="d-flex align-items-center gap-2">
                {% render 'icon', name: 'check-circle', class: 'flex-shrink-0' %}
                <span>{{ 'theme.pages.maker_form.success' | t }}</span>
              </div>
            </div>
            <div class="alert alert-danger mb-3" role="alert" tabindex="-1" hidden data-maker-form-error>
              {{ 'theme.pages.maker_form.error' | t }}
            </div>

            <form id="{{ form_id }}" action="{{ form_url | escape }}" method="post" target="_blank">
              <div class="contact-form__fields maker-form__fields d-grid">
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-name">{{ 'theme.pages.maker_form.name' | t }}</label>
                  <input type="text" id="{{ form_id }}-name" class="form-control" name="entry.1292086501" autocomplete="name" required placeholder="{{ 'theme.pages.maker_form.name' | t }}">
                </div>
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-business">{{ 'theme.pages.maker_form.business' | t }}</label>
                  <input type="text" id="{{ form_id }}-business" class="form-control" name="entry.1593059719" autocomplete="organization" required placeholder="{{ 'theme.pages.maker_form.business' | t }}">
                </div>
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-website">{{ 'theme.pages.maker_form.website' | t }}</label>
                  <input type="text" id="{{ form_id }}-website" class="form-control" name="entry.933057703" inputmode="url" autocomplete="url" spellcheck="false" autocapitalize="off" required placeholder="{{ 'theme.pages.maker_form.website' | t }}">
                </div>
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-email">{{ 'theme.pages.maker_form.email' | t }}</label>
                  <input type="email" id="{{ form_id }}-email" class="form-control" name="entry.907364877" autocomplete="email" spellcheck="false" autocapitalize="off" required placeholder="{{ 'theme.pages.maker_form.email' | t }}">
                </div>
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-location">{{ 'theme.pages.maker_form.location' | t }}</label>
                  <input type="text" id="{{ form_id }}-location" class="form-control" name="entry.119127261" required placeholder="{{ 'theme.pages.maker_form.location' | t }}">
                </div>
                <div>
                  <label class="visually-hidden" for="{{ form_id }}-referral">{{ 'theme.pages.maker_form.referral' | t }}</label>
                  <input type="text" id="{{ form_id }}-referral" class="form-control" name="entry.1327298777" required placeholder="{{ 'theme.pages.maker_form.referral' | t }}">
                </div>
                <div class="maker-form__full">
                  <label class="visually-hidden" for="{{ form_id }}-story">{{ 'theme.pages.maker_form.story' | t }}</label>
                  <textarea id="{{ form_id }}-story" class="form-control" name="entry.908810342" rows="10" required placeholder="{{ 'theme.pages.maker_form.story' | t }}"></textarea>
                </div>
                <div class="maker-form__full">
                  <button type="submit" class="contact-form__submit btn btn-dark">
                    {{ 'theme.pages.maker_form.submit' | t }}
                  </button>
                </div>
              </div>
            </form>
          </maker-form>
        {%- elsif request.design_mode -%}
          <div class="alert alert-warning mb-0">{{ 'theme.pages.maker_form.setup' | t }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maker application",
  "tag": "div",
  "class": "section-maker-form",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Apply to be a maker"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "italic", "label": "Italic" },
        { "value": "regular", "label": "Regular" }
      ],
      "default": "italic"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level (for search engines)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Google Form"
    },
    {
      "type": "text",
      "id": "form_url",
      "label": "Form response URL",
      "info": "The Google Form's address ending in /formResponse. Applications are saved in that form, not emailed.",
      "default": "https://docs.google.com/forms/d/e/1FAIpQLSfu4RAdsAdIXk5547Xv-VE7b0eGCZPA9lyYkYHqOYvtAl6TTg/formResponse"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "info": "Directly after the page content, the top spacing is removed.",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Maker application"
    }
  ]
}
{% endschema %}
