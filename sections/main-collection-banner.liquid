{%- liquid
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif
-%}

{{ 'section-main-collection-banner.css' | asset_url | stylesheet_tag }}

{%- if show_image -%}
  <section class="collection-banner collection-banner--image collection-banner--{{ section.settings.image_height }} container-fluid px-0 position-relative d-flex align-items-end text-white overflow-hidden">
    {{
      collection.image
      | image_url: width: 2400
      | image_tag:
        class: 'collection-banner__image position-absolute top-0 start-0 w-100 h-100 object-fit-cover',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1800, 2400',
        alt: '',
        fetchpriority: 'high'
    }}
    <div
      class="position-absolute top-0 start-0 w-100 h-100 bg-dark"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
    ></div>
    <div class="container position-relative py-5">
      <div class="row">
        <div class="col-12 col-lg-8">
          <h1 class="collection-banner__title mb-0">{{ collection.title | escape }}</h1>
          {%- if section.settings.show_collection_description and collection.description != blank -%}
            <div class="collection-banner__description rte mt-3">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  <section class="collection-banner container-fluid px-0">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <h1 class="collection-banner__title mb-0">{{ collection.title | escape }}</h1>
          {%- if section.settings.show_collection_description and collection.description != blank -%}
            <div class="collection-banner__description rte">{{ collection.description }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection banner",
  "tag": "div",
  "class": "section-main-collection-banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the collection's title. Edit the title, description and image under Products > Collections."
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "info": "Shows the title over the collection's image.",
      "default": false
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "regular", "label": "Regular" }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    }
  ]
}
{% endschema %}
