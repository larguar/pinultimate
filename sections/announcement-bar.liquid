<div class="announcement-bar container-fluid px-0 bg-primary text-white" data-bs-theme="dark">
  <div class="container">
    <div class="row align-items-center">
      {%- if section.settings.show_social_icons -%}
        <div class="col-3 d-none d-md-block">
          {% render 'social-icons', class: 'announcement-bar__social', link_class: 'px-2 py-2' %}
        </div>
      {%- endif -%}

      <div class="col text-center overflow-hidden">
        {%- if section.blocks.size > 1 -%}
          <swiper-slider
            data-options='{
              "loop": true,
              "allowTouchMove": true,
              "autoHeight": true
              {%- if section.settings.autoplay -%}
                , "autoplay": { "delay": {{ section.settings.autoplay_speed | times: 1000 }}, "pauseOnMouseEnter": true }
              {%- endif -%}
            }'
          >
            <div class="swiper">
              <div class="swiper-wrapper">
                {%- for block in section.blocks -%}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    {% render 'announcement-bar-message', block: block %}
                  </div>
                {%- endfor -%}
              </div>
            </div>
          </swiper-slider>
        {%- else -%}
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {% render 'announcement-bar-message', block: block %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_localization -%}
        <div class="col-3 d-none d-md-flex justify-content-end">
          {% render 'localization-dropdown', id: 'AnnouncementLocalization' %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement-bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "info": "Set the links in Theme settings > Social media.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country/currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate messages automatically",
      "info": "When off, visitors swipe to see more messages.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change message every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Welcome to our store"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
