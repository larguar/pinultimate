{%- liquid
  assign heading_class = 'mb-4'
  if section.settings.heading_alignment == 'center'
    assign heading_class = 'text-center mb-4'
  endif
-%}

<section class="apps container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}">
  <div class="{% if section.settings.full_width %}container-fluid px-0{% else %}container{% endif %}">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="{% if section.settings.full_width %}container{% endif %}">
        {% render 'section-heading',
          heading: section.settings.heading,
          subheading: section.settings.subheading,
          class: heading_class
        %}
      </div>
    {%- endif -%}

    <div class="row{% if section.settings.full_width %} g-0{% endif %}">
      <div class="col-12">
        {%- for block in section.blocks -%}
          {% render block %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Apps",
  "tag": "div",
  "class": "section-apps",
  "settings": [
    {
      "type": "paragraph",
      "content": "Holds app blocks, such as product reviews."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Shown in the script font above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "Lets the app fill the whole width of the screen, edge to edge.",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
