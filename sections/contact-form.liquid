{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<section class="contact-form container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}">
  <div class="container">
    <div class="row gx-5 row-gap-4">
      <div class="col-12 col-lg-6">
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="contact-form__heading{% if section.settings.heading_style == 'italic' %} fst-italic{% endif %}">
            {{- section.settings.heading | escape -}}
          </{{ heading_tag }}>
        {%- endif -%}

        {%- form 'contact', id: form_id -%}
          {% render 'contact-form-fields',
            form: form,
            form_id: form_id,
            show_phone: section.settings.show_phone,
            show_subject: section.settings.show_subject
          %}
        {%- endform -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="col-12 col-md-6 col-lg-3" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="contact-form__heading{% if section.settings.heading_style == 'italic' %} fst-italic{% endif %}">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.content != blank -%}
            <div class="contact-form__info rte border rounded p-4">
              {{ block.settings.content }}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "tag": "div",
  "class": "section-contact-form",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Drop us a line"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "Heading style",
      "options": [
        { "value": "italic", "label": "Italic" },
        { "value": "regular", "label": "Regular" }
      ],
      "default": "italic"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level (for search engines)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Form fields"
    },
    {
      "type": "paragraph",
      "content": "Messages are sent to the store's sender email (Settings > Notifications)."
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone number",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Show subject",
      "default": false
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "info": "Directly after the page content, the top spacing is removed.",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Contact information",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Contact information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "default": "<p>Share your address, opening hours or links to helpful pages.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
