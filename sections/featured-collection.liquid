{%- liquid
  assign collection = section.settings.collection
  assign collection_title = collection.title | default: ''
  assign heading = section.settings.heading | replace: '{collection}', collection_title
  assign subheading = section.settings.subheading | replace: '{collection}', collection_title
  assign button_label = section.settings.button_label | replace: '{collection}', collection_title
  assign compact = false
  if section.settings.style == 'compact'
    assign compact = true
  endif

  assign background_class = ''
  if section.settings.background != 'none'
    assign background_class = 'bg-' | append: section.settings.background
  endif
-%}

{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

<section
  class="featured-collection{% if compact %} featured-collection--compact{% endif %} container-fluid px-0 {{ background_class }} {% if section.settings.background != 'none' %}{% render 'section-spacing', property: 'p', side: 'y', size: section.settings.spacing %}{% else %}{% render 'section-spacing', size: section.settings.spacing %}{% endif %}"
>
  <div class="container">
    {% render 'section-heading',
      heading: heading,
      subheading: subheading,
      class: 'text-center mb-3 mb-md-1'
    %}

    {%- if compact -%}
      {%- comment -%} One row of product images; items past each breakpoint's column count are hidden. {%- endcomment -%}
      <div class="row row-cols-3 row-cols-sm-4 row-cols-md-5 row-cols-lg-6 g-0">
        {%- for product in collection.products limit: section.settings.products_count -%}
          <div class="col{% if forloop.index == 4 %} d-none d-sm-block{% elsif forloop.index == 5 %} d-none d-md-block{% elsif forloop.index > 5 %} d-none d-lg-block{% endif %}">
            {% render 'product-card',
              product: product,
              show_title: false,
              show_vendor: false,
              show_price: false,
              show_badges: false,
              show_swatches: false,
              tile: false,
              sizes: '(min-width: 992px) 17vw, (min-width: 768px) 20vw, 33vw'
            %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="row row-cols-{{ section.settings.columns_mobile }} row-cols-md-3 row-cols-lg-{{ section.settings.columns_desktop }} g-1">
        {%- for product in collection.products limit: section.settings.products_count -%}
          <div class="col">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and button_label != blank -%}
      <div class="text-center mt-3 mt-md-2">
        <a href="{{ collection.url }}" class="btn btn-outline-dark btn-cta">{{ button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "div",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "paragraph",
      "content": "In the heading, subheading and button label, {collection} is replaced with the collection's title."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Shown in the script font above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "cards", "label": "Product cards" },
        { "value": "compact", "label": "Single row of images" }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "info": "Product cards style only.",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "info": "Product cards style only.",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop {collection}"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
