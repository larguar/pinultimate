{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign preselect = section.settings.preselect_variant
  if product.has_only_default_variant
    assign preselect = true
  endif
  # A variant chosen through the URL counts as a selection.
  if product.selected_variant
    assign preselect = true
  endif

  assign media_count = product.media.size

  # Column widths: media half or two thirds of the row from md up.
  if section.settings.media_width == 'two_thirds'
    assign media_col = 'col-md-7 col-lg-8'
    assign info_col = 'col-md-5 col-lg-4'
  else
    assign media_col = 'col-md-6'
    assign info_col = 'col-md-6'
  endif

  assign fit_class = 'object-fit-contain'
  if section.settings.media_fit == 'cover'
    assign fit_class = 'object-fit-cover'
  endif

  # The maker's collection, for the vendor link and the product details. [LG] Vendor Collection Link
  assign maker_collection = nil
  for c in product.collections
    if c.title == product.vendor
      assign maker_collection = c
      break
    endif
  endfor
  if maker_collection == nil and product.vendor != blank
    for c in collections
      if c.title == product.vendor
        assign maker_collection = c
        break
      endif
    endfor
  endif

  # "Show beside" grouping: price blocks can share a line with the block before or after them
  # (a star rating app block, for example). Collect the block indexes that open and close a group.
  assign group_open = ','
  assign group_close = ','
  for block in section.blocks
    if block.type == 'price'
      if block.settings.beside == 'next' and forloop.last == false
        assign next_index = forloop.index | plus: 1
        assign group_open = group_open | append: forloop.index | append: ','
        assign group_close = group_close | append: next_index | append: ','
      elsif block.settings.beside == 'previous' and forloop.first == false
        assign prev_index = forloop.index | minus: 1
        assign group_open = group_open | append: prev_index | append: ','
        assign group_close = group_close | append: forloop.index | append: ','
      endif
    endif
  endfor
-%}

{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-main-product.js' | asset_url }}" defer></script>

<main-product
  class="main-product{% if section.settings.sticky_info %} main-product--sticky{% endif %} d-block container-fluid px-0"
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  {% unless preselect %}
    data-variant-required
  {% endunless %}
>
  <div class="container">
    <div class="row main-product__row">
      {%- comment -%} Media {%- endcomment -%}
      <div class="col-12 {{ media_col }}">
        {%- liquid
          assign slider_options = '{"slidesPerView": 1, "spaceBetween": 15, "autoHeight": false'
          if section.settings.media_layout != 'slider'
            assign slider_options = slider_options | append: ', "breakpoints": {"768": {"enabled": false}}'
          endif
          assign slider_options = slider_options | append: '}'

          assign gallery_class = 'main-product__gallery--' | append: section.settings.media_layout
          assign sizes = '(min-width: 1360px) 640px, (min-width: 768px) 50vw, 100vw'
          if section.settings.media_layout == 'stack_2'
            assign sizes = '(min-width: 1360px) 320px, (min-width: 768px) 25vw, 100vw'
          endif
          if section.settings.media_width == 'two_thirds'
            assign sizes = '(min-width: 1360px) 860px, (min-width: 768px) 66vw, 100vw'
            if section.settings.media_layout == 'stack_2'
              assign sizes = '(min-width: 1360px) 430px, (min-width: 768px) 33vw, 100vw'
            endif
          endif
        -%}
        <swiper-slider
          class="main-product__gallery {{ gallery_class }} d-block"
          data-options='{{ slider_options }}'
          data-main-product-gallery
          role="region"
          aria-label="{{ 'theme.product_page.gallery' | t }}"
        >
          <div class="swiper">
            <div class="swiper-wrapper">
              {%- for media in product.media -%}
                <div
                  class="swiper-slide main-product__media-item"
                  data-media-id="{{ media.id }}"
                  role="group"
                  aria-label="{{ 'theme.product_page.media_label' | t: index: forloop.index, count: media_count }}"
                >
                  <div class="ratio ratio-{{ section.settings.media_ratio }}{% if section.settings.media_tile %} bg-tile{% endif %}">
                    {%- if media.media_type == 'image' -%}
                      {%- liquid
                        assign loading = 'lazy'
                        assign priority = 'auto'
                        if forloop.first
                          assign loading = 'eager'
                          assign priority = 'high'
                        endif
                      -%}
                      {{
                        media
                        | image_url: width: 1500
                        | image_tag:
                          class: fit_class,
                          alt: media.alt,
                          loading: loading,
                          fetchpriority: priority,
                          sizes: sizes,
                          widths: '375, 550, 750, 1000, 1250, 1500'
                      }}
                    {%- else -%}
                      <div class="main-product__media-embed">
                        {{ media | media_tag: image_size: '1500x', autoplay: false, loop: section.settings.video_loop }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- else -%}
                <div class="swiper-slide main-product__media-item">
                  <div class="ratio ratio-{{ section.settings.media_ratio }} bg-tile">
                    {{ 'product-1' | placeholder_svg_tag: 'w-100 h-100' }}
                  </div>
                </div>
              {%- endfor -%}
            </div>

            {%- if media_count > 1 -%}
              <div class="main-product__gallery-nav d-flex align-items-center justify-content-center">
                <button type="button" class="swiper-button-prev main-product__gallery-button" aria-label="{{ 'theme.product_page.previous_image' | t }}">
                  {%- render 'icon', name: 'chevron-left' -%}
                </button>
                <div
                  class="swiper-pagination main-product__gallery-pagination d-flex"
                  style="--count: {{ media_count }}"
                ></div>
                <button type="button" class="swiper-button-next main-product__gallery-button" aria-label="{{ 'theme.product_page.next_image' | t }}">
                  {%- render 'icon', name: 'chevron-right' -%}
                </button>
              </div>
            {%- endif -%}
          </div>
        </swiper-slider>
      </div>

      {%- comment -%} Product information {%- endcomment -%}
      <div class="col-12 {{ info_col }}">
        <div class="main-product__info{% if section.settings.sticky_info %} main-product__info--sticky{% endif %}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign index_token = ',' | append: forloop.index | append: ','
              if group_open contains index_token
                echo '<div class="main-product__group d-flex flex-wrap align-items-center">'
              endif
            -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="main-product__block main-product__block--app" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>

              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <p class="main-product__block main-product__vendor mb-0" {{ block.shopify_attributes }}>
                    {%- if maker_collection -%}
                      <a href="{{ maker_collection.url }}" class="text-reset">{{ product.vendor | escape }}</a>
                    {%- else -%}
                      <span>{{ product.vendor | escape }}</span>
                    {%- endif -%}
                  </p>
                {%- endif -%}

              {%- when 'title' -%}
                {%- comment -%} [LG] Short Title: "Booked Enamel Pin by Tiny Bee Cards" shows as "Booked Pin". {%- endcomment -%}
                {%- assign short_title = product.title | split: ' by ' | first | remove: 'Enamel ' -%}
                <h1 class="main-product__block main-product__title" {{ block.shopify_attributes }}>
                  {{- short_title | escape -}}
                </h1>

              {%- when 'price' -%}
                <div class="main-product__block main-product__price-row" {{ block.shopify_attributes }}>
                  <div data-main-product-update="price-{{ block.id }}">
                    {%- if preselect -%}
                      {% render 'price', product: product, variant: current_variant, class: 'main-product__price' %}
                    {%- else -%}
                      {% render 'price', product: product, class: 'main-product__price' %}
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'badges' -%}
                {%- comment -%} "More Options" is a product card badge; the previous theme didn't show it here. {%- endcomment -%}
                <div class="main-product__block main-product__badges" {{ block.shopify_attributes }} data-main-product-update="badges-{{ block.id }}">
                  {% render 'product-badges', product: product, direction: 'row', show_more_options: false %}
                </div>

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="main-product__block main-product__text rte{% if block.settings.uppercase %} text-uppercase{% endif %} main-product__text--{{ block.settings.size }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="main-product__block main-product__description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="main-product__block main-product__variants" {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      {%- assign select_id = 'Option-' | append: section.id | append: '-' | append: forloop.index0 -%}
                      <div class="main-product__option">
                        <label
                          class="main-product__option-label form-label{% unless block.settings.show_labels %} visually-hidden{% endunless %}"
                          for="{{ select_id }}"
                        >
                          {{- 'theme.product_page.select_option' | t: option: option.name -}}
                        </label>
                        <select
                          id="{{ select_id }}"
                          class="form-select main-product__select"
                          name="options[{{ option.name | escape }}]"
                          data-option-position="{{ option.position }}"
                          data-unavailable="{{ block.settings.unavailable }}"
                        >
                          {%- unless preselect -%}
                            <option value="" disabled selected>{{ 'theme.product_page.select_option' | t: option: option.name }}</option>
                          {%- endunless -%}
                          {%- for value in option.values -%}
                            <option
                              value="{{ value | escape }}"
                              {% if preselect and option.selected_value == value %}
                                selected
                              {% endif %}
                              {% unless value.variant or value.product_url %}
                                {% if block.settings.unavailable == 'disable' %}
                                  disabled
                                {% elsif block.settings.unavailable == 'hide' %}
                                  disabled hidden
                                {% endif %}
                              {% endunless %}
                            >
                              {{- value | escape -}}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

              {%- when 'buy_buttons' -%}
                {%- liquid
                  assign button_disabled = false
                  if preselect
                    if current_variant.available
                      assign button_label = 'theme.product_page.add_to_cart' | t
                    else
                      assign button_disabled = true
                      # [LG] Custom Sold Out Button Text
                      if current_variant == null
                        assign button_label = 'theme.product_page.unavailable' | t
                      elsif product.tags contains 'clearance'
                        assign button_label = 'theme.product_page.gone_for_good' | t
                      elsif current_variant.incoming
                        assign button_label = 'theme.product_page.more_on_the_way' | t
                      else
                        assign button_label = 'theme.product_page.temporarily_out' | t
                      endif
                    endif
                  else
                    assign button_disabled = true
                    if product.available
                      assign button_label = 'theme.product_page.choose_variant' | t
                    else
                      assign button_label = 'theme.product_page.sold_out' | t
                    endif
                  endif
                -%}
                <div class="main-product__block main-product__buy" {{ block.shopify_attributes }}>
                  <form
                    action="{{ routes.cart_add_url }}"
                    method="post"
                    class="main-product__form"
                    data-add-to-cart
                    data-main-product-form
                  >
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <div class="d-flex">
                      {%- if block.settings.show_quantity -%}
                        {% render 'quantity-stepper', product: product %}
                      {%- endif -%}
                      <button
                        type="submit"
                        name="add"
                        class="btn btn-dark main-product__add text-uppercase flex-grow-1{% unless block.settings.show_quantity %} main-product__add--solo{% endunless %}"
                        data-main-product-update="button"
                        {% if button_disabled %}
                          disabled
                        {% endif %}
                      >
                        {{- button_label -}}
                      </button>
                    </div>
                    <div class="main-product__error alert alert-danger small mt-2 mb-0 py-2" role="alert" data-add-to-cart-error hidden></div>
                  </form>

                  {%- if block.settings.show_payment_terms -%}
                    <div class="main-product__installments">
                      {%- assign installments_id = section.id | append: '-installments' -%}
                      {%- form 'product', product, id: installments_id -%}
                        <input type="hidden" name="id" value="{{ current_variant.id }}">
                        {{ form | payment_terms }}
                      {%- endform -%}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'collapsible_tab' -%}
                {%- liquid
                  assign tab_content = block.settings.content | append: block.settings.page.content
                  assign show_tab = true
                  if tab_content == blank and block.settings.show_product_details == false
                    assign show_tab = false
                  endif
                -%}
                {%- if show_tab -%}
                  <div class="main-product__block main-product__tab" {{ block.shopify_attributes }}>
                    <h2 class="main-product__tab-heading m-0">
                      <button
                        type="button"
                        class="main-product__tab-toggle collapsed d-flex w-100 align-items-center justify-content-between text-start"
                        data-bs-toggle="collapse"
                        data-bs-target="#Tab-{{ block.id }}"
                        aria-expanded="false"
                        aria-controls="Tab-{{ block.id }}"
                      >
                        {{- block.settings.heading | escape -}}
                        <span class="main-product__tab-icon" aria-hidden="true"></span>
                      </button>
                    </h2>
                    <div id="Tab-{{ block.id }}" class="collapse">
                      <div class="main-product__tab-content rte">
                        {{- tab_content -}}
                        {%- if block.settings.show_product_details -%}
                          {% render 'main-product-details', product: product, maker_collection: maker_collection %}
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                {%- if block.settings.custom_liquid != blank -%}
                  <div class="main-product__block main-product__custom" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
            {%- liquid
              if group_close contains index_token
                echo '</div>'
              endif
            -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-main-product-variants>
    {{ product.variants | json }}
  </script>
</main-product>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Desktop layout",
      "info": "On mobile the images are always shown as a slider.",
      "options": [
        { "value": "stack", "label": "Stacked, one column" },
        { "value": "stack_2", "label": "Stacked, two columns" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Media width on desktop",
      "options": [
        { "value": "half", "label": "Half" },
        { "value": "two_thirds", "label": "Two thirds" }
      ],
      "default": "half"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1x1", "label": "Square" },
        { "value": "5x6", "label": "Portrait (5:6)" },
        { "value": "4x5", "label": "Portrait (4:5)" },
        { "value": "3x4", "label": "Portrait (3:4)" }
      ],
      "default": "5x6"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show the whole image" },
        { "value": "cover", "label": "Fill the frame (may crop)" }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "media_tile",
      "label": "Light gray background behind images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop videos",
      "default": false
    },
    {
      "type": "header",
      "content": "Product information"
    },
    {
      "type": "checkbox",
      "id": "preselect_variant",
      "label": "Preselect the first available variant",
      "info": "When off, customers must choose every option before they can add the product to the cart.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Keep the shorter column in view while scrolling (desktop)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Links to the collection with the same name as the vendor, when there is one."
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the title without \"Enamel\" and without \"by …\" (\"Booked Enamel Pin by Tiny Bee Cards\" shows as \"Booked Pin\")."
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "beside",
          "label": "Show on one line with",
          "info": "Use this to put a star rating app block next to the price.",
          "options": [
            { "value": "none", "label": "Nothing" },
            { "value": "previous", "label": "The block above" },
            { "value": "next", "label": "The block below" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "badges",
      "name": "Badges",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows badges such as \"Last Chance\" and \"Only 3 left!\" based on product tags and stock."
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_labels",
          "label": "Show option labels",
          "default": true
        },
        {
          "type": "select",
          "id": "unavailable",
          "label": "Option combinations that don't exist",
          "options": [
            { "value": "disable", "label": "Show as unavailable" },
            { "value": "hide", "label": "Hide" },
            { "value": "show", "label": "Show" }
          ],
          "default": "disable"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_payment_terms",
          "label": "Show Shop Pay installments",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text block</p>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Text size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "regular", "label": "Regular" },
            { "value": "large", "label": "Large" }
          ],
          "default": "regular"
        },
        {
          "type": "checkbox",
          "id": "uppercase",
          "label": "Uppercase",
          "default": false
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collapsible tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from a page"
        },
        {
          "type": "checkbox",
          "id": "show_product_details",
          "label": "Add the product details",
          "info": "Lists the maker, dimensions, weight, type, plating, colors, clutch and posts from the product's variant metafields.",
          "default": false
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "vendor" },
      { "type": "title" },
      { "type": "price" },
      { "type": "badges" },
      { "type": "variant_picker" },
      { "type": "buy_buttons" },
      { "type": "description" }
    ]
  }
}
{% endschema %}
