{%- comment -%}
  Email sign-up card: heading, email field and a short note below. Sign-ups are saved as
  customers tagged "newsletter" (Shopify's customer form).
{%- endcomment -%}
{%- liquid
  assign form_id = 'newsletter-' | append: section.id
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  assign card_class = ''
  if section.settings.background != 'none'
    assign card_class = 'bg-' | append: section.settings.background
  endif
-%}
{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

<div class="newsletter container-fluid px-0 {% render 'section-spacing', size: section.settings.spacing %}">
  <div class="{% if section.settings.full_width %}container-fluid px-0{% else %}container{% endif %}">
    <div class="newsletter__card {{ card_class }} text-center">
      <div class="newsletter__inner mx-auto">
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="newsletter__heading mb-0">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="newsletter__success mb-0" role="status" tabindex="-1" autofocus>
              {{- 'theme.utility.newsletter.success' | t -}}
            </p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="alert alert-danger py-2 small text-start" role="alert" id="{{ form_id }}-error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="row g-3 align-items-center justify-content-center">
              <div class="col-12 col-sm">
                <label for="{{ form_id }}-email" class="visually-hidden">{{ 'theme.utility.newsletter.email' | t }}</label>
                <input
                  type="email"
                  name="contact[email]"
                  id="{{ form_id }}-email"
                  class="form-control newsletter__input{% if form.errors %} is-invalid{% endif %}"
                  value="{{ form.email | default: customer.email }}"
                  placeholder="{{ 'theme.utility.newsletter.email' | t }}"
                  autocomplete="email"
                  autocapitalize="off"
                  autocorrect="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="{{ form_id }}-error"
                  {% endif %}
                >
              </div>
              <div class="col-12 col-sm-auto">
                <button type="submit" class="btn btn-dark w-100 newsletter__button">
                  {{- 'theme.utility.newsletter.submit' | t -}}
                </button>
              </div>
            </div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.text != blank -%}
          <div class="newsletter__text rte small">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email sign-up",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text below the form",
      "default": "<p>Be the first to know about new arrivals and exclusive offers.</p>"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "For search engines; the heading looks the same.",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2"
    },
    {
      "type": "paragraph",
      "content": "Sign-ups are added to Customers with the tag \"newsletter\"."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Card background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "light", "label": "Light" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Vertical spacing",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "small", "label": "Small" },
        { "value": "none", "label": "None" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Email sign-up"
    }
  ]
}
{% endschema %}
