{%- liquid
  case section.settings.columns_desktop
    when '2'
      assign cols = 'row-cols-1 row-cols-md-2'
      assign sizes = '(min-width: 1360px) 640px, (min-width: 768px) 47vw, 92vw'
    when '4'
      assign cols = 'row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4'
      assign sizes = '(min-width: 1360px) 316px, (min-width: 1200px) 23vw, (min-width: 768px) 31vw, (min-width: 576px) 46vw, 92vw'
    else
      assign cols = 'row-cols-1 row-cols-sm-2 row-cols-md-3'
      assign sizes = '(min-width: 1360px) 425px, (min-width: 768px) 31vw, (min-width: 576px) 46vw, 92vw'
  endcase

  if section.settings.display_type == 'all'
    case section.settings.sort
      when 'products_high', 'products_low'
        assign list = collections | sort: 'all_products_count'
      when 'date', 'date_reversed'
        assign list = collections | sort: 'published_at'
      else
        assign list = collections
    endcase
    assign reversed = false
    if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
      assign reversed = true
    endif
  endif
-%}

{{ 'section-main-list-collections.css' | asset_url | stylesheet_tag }}

<section class="list-collections container-fluid px-0">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <h1 class="list-collections__title mb-0">
          {%- if section.settings.title != blank -%}
            {{ section.settings.title | escape }}
          {%- else -%}
            {{ 'theme.collection.list_title' | t }}
          {%- endif -%}
        </h1>
      </div>
    </div>

    <div class="list-collections__grid row {{ cols }}">
      {%- if section.settings.display_type == 'all' -%}
        {%- if reversed -%}
          {%- for collection in list reversed -%}
            {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
            <div class="col">
              {% render 'main-list-collections-item', collection: collection, ratio: section.settings.image_ratio, sizes: sizes, index: forloop.index0, lazy: false %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for collection in list -%}
            {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
            <div class="col">
              {% render 'main-list-collections-item', collection: collection, ratio: section.settings.image_ratio, sizes: sizes, index: forloop.index0, lazy: false %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection == blank -%}{%- continue -%}{%- endif -%}
          <div class="col">
            {% render 'main-list-collections-item',
              collection: block.settings.collection,
              image: block.settings.image,
              ratio: section.settings.image_ratio,
              sizes: sizes,
              index: forloop.index0,
              attributes: block.shopify_attributes
            %}
          </div>
        {%- else -%}
          <div class="col-12">
            <p class="mb-0">{{ 'theme.collection.no_collections' | t }}</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list page",
  "tag": "div",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Collections"
    },
    {
      "type": "radio",
      "id": "display_type",
      "label": "Collections to show",
      "options": [
        { "value": "all", "label": "All collections" },
        { "value": "selected", "label": "Only the collections added below" }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Order",
      "info": "When showing all collections.",
      "options": [
        { "value": "alphabetical", "label": "Alphabetically, A-Z" },
        { "value": "alphabetical_reversed", "label": "Alphabetically, Z-A" },
        { "value": "date_reversed", "label": "Newest first" },
        { "value": "date", "label": "Oldest first" },
        { "value": "products_high", "label": "Most products first" },
        { "value": "products_low", "label": "Fewest products first" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "4x3", "label": "Landscape (4:3)" },
        { "value": "1x1", "label": "Square" },
        { "value": "5x6", "label": "Portrait (5:6)" },
        { "value": "2x3", "label": "Tall (2:3)" }
      ],
      "default": "1x1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the collection's own image."
        }
      ]
    }
  ]
}
{% endschema %}
