[
  {
    "name": "theme_info",
    "theme_name": "Pinultimate",
    "theme_version": "1.0.0",
    "theme_author": "Think It First",
    "theme_documentation_url": "https://thinkitfirst.com",
    "theme_support_url": "https://thinkitfirst.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height",
        "min": 20,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 58
      },
      {
        "type": "image_picker",
        "id": "logo_mobile",
        "label": "Mobile logo",
        "info": "Shown below 992px. Falls back to the logo."
      },
      {
        "type": "range",
        "id": "logo_height_mobile",
        "label": "Mobile logo height",
        "min": 20,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Shown at 32 x 32px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "These override Bootstrap's theme colors, so classes like bg-primary and text-yellow follow them."
      },
      {
        "type": "color",
        "id": "color_body_text",
        "label": "Body text",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_body_bg",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "info": "Buttons, announcement bar and footer.",
        "default": "#14452f"
      },
      {
        "type": "color",
        "id": "color_light",
        "label": "Light",
        "info": "Alternate section background.",
        "default": "#f4f3f2"
      },
      {
        "type": "color",
        "id": "color_dark",
        "label": "Dark",
        "default": "#1e1e1e"
      },
      {
        "type": "header",
        "content": "Accent colors"
      },
      {
        "type": "color",
        "id": "color_green",
        "label": "Green (secondary)",
        "default": "#c6cc3d"
      },
      {
        "type": "color",
        "id": "color_red",
        "label": "Red",
        "default": "#f6786c"
      },
      {
        "type": "color",
        "id": "color_yellow",
        "label": "Yellow",
        "default": "#feff86"
      },
      {
        "type": "color",
        "id": "color_blue",
        "label": "Blue",
        "default": "#8ed6cf"
      },
      {
        "type": "color",
        "id": "color_purple",
        "label": "Purple",
        "default": "#ddc7e8"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "poppins_n4"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "poppins_n6"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "1x1", "label": "Square (1:1)" },
          { "value": "5x6", "label": "Portrait (5:6)" },
          { "value": "4x5", "label": "Portrait (4:5)" },
          { "value": "3x4", "label": "Portrait (3:4)" }
        ],
        "default": "5x6"
      },
      {
        "type": "checkbox",
        "id": "card_image_contain",
        "label": "Show the whole image",
        "info": "Fits the image inside the frame instead of cropping it.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "After adding to cart",
        "options": [
          { "value": "drawer", "label": "Open the cart drawer" },
          { "value": "page", "label": "Go to the cart page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_enabled",
        "label": "Show free shipping progress",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In the store's currency, without symbol.",
        "default": "50"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Show search suggestions",
        "default": true
      }
    ]
  },
  {
    "name": "Currency format",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Show currency codes",
        "default": false
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "https://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_threads_link",
        "label": "Threads",
        "placeholder": "https://threads.net/@shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "placeholder": "https://youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)",
        "placeholder": "https://x.com/shopify"
      }
    ]
  }
]
