  // }, 0.1);
  {% comment %} [LG] End Clickable Mega Menu Links {% endcomment %}

  
  {% comment %} Footer Reviews Count {% endcomment %}
  setTimeout(() => {
    let reviewCount = document.getElementById("_352").textContent.trim();
    document.getElementById("review-count").innerHTML = reviewCount;
  }, 2000);

  {% comment %} Animation on Page Load {% endcomment %}
  setTimeout(function() {
    trigger.style.right = "-100px";
    setTimeout(function() {
      trigger.style.webkitAnimation = "bounce 2s";
      trigger.style.animation = "bounce 2s";
    }, 500);
  }, 5000);

  //showClutchOptions();
