const trigger = document.querySelector(".klaviyo_form_trigger");

window.onload = function () {

  {% comment %} [LG] Remove Button Animation Classes {% endcomment %}
  document.querySelectorAll(".button").forEach(function(btn) {
    if (btn.classList.contains("button--icon")) {
      btn.classList.remove("button--icon");
    }
    if (btn.classList.contains("button--arrow-right")) {
      btn.classList.remove("button--arrow-right");
    }
  });
  
  {% comment %} [LG] Clickable Mega Menu Links {% endcomment %}
  // let pinsID = "mega_menu_6t4AGw";
  // let extrasID = "mega_menu_7Cnq9A";
  // let pinsURL = "/collections/pins";
  // let extrasURL = "/collections/extras";
