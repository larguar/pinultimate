{% comment %} Trigger Pop Up on Click {% endcomment %}
trigger.addEventListener('click', function() {
  this.style.right = "-160px";
  window._klOnsite = window._klOnsite || [];
  window._klOnsite.push(['openForm', trigger.id.split("-")[1]]);
  setTimeout(function() {
    trigger.style.right = "-100px";
  }, 10000);
});
trigger.addEventListener('touchstart', function() {
  this.style.right = "-160px";
  window._klOnsite = window._klOnsite || [];
  window._klOnsite.push(['openForm', trigger.id.split("-")[1]]);
  setTimeout(function() {
    trigger.style.right = "-100px";
  }, 10000);
});

