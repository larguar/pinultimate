    overflow: hidden;
    border-radius: 50%;
    border: 1px solid #ccc;
}
.var-img img {
    max-width: 100%;
    transform: scale(6);
}
.var-img-container {
    border: 1px solid transparent;
    padding: 1px;
    border-radius: 50%;
    margin-right: 2px;
  transition: 0.2s ease;
}
.var-container .var-img-container:first-child {
  border-color: #1e1e1e;
}
.var-container .var-img-container:not(:first-child):hover {
  border-color: {{ green }};
}
span.var-options {
    font-size: 13px;
    line-height: 12px;
    margin-top: 2px;
    margin-left: 2px;
    color: #777;
}
.product-item__price {
    margin-bottom: 12px;
}

