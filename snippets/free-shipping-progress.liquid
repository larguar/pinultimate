{%- comment -%}
  Progress towards the free shipping threshold set in theme settings.

  Accepts:
  - class {String}: wrapper classes (optional)
{%- endcomment -%}
{%- if settings.cart_free_shipping_enabled and settings.cart_free_shipping_threshold != blank -%}
  {%- liquid
    # The threshold is compared as-is in the visitor's currency, as the previous theme did.
    assign threshold = settings.cart_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign remaining_money = remaining | money
    assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
  -%}
  <div class="free-shipping {{ class }}">
    <p class="small mb-2">
      {%- if remaining > 0 -%}
        {{ 'theme.cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'theme.cart.free_shipping_eligible' | t }}
      {%- endif -%}
    </p>
    <div
      class="progress free-shipping__bar"
      role="progressbar"
      aria-valuenow="{{ progress | round }}"
      aria-valuemin="0"
      aria-valuemax="100"
    >
      <div class="progress-bar bg-dark" style="width: {{ progress }}%"></div>
    </div>
  </div>
{%- endif -%}
