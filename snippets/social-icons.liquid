{%- comment -%}
  Links to the social accounts set in theme settings, each in its brand accent color.

  Accepts:
  - class {String}: classes for the <ul> (optional)
  - link_class {String}: classes for each link (optional)
{%- endcomment -%}
{%- liquid
  assign networks = 'instagram,facebook,threads,tiktok,pinterest,youtube,twitter' | split: ','
  assign labels = 'Instagram,Facebook,Threads,TikTok,Pinterest,YouTube,X' | split: ','
  assign colors = 'purple,blue,secondary,yellow,red,purple,blue' | split: ','
-%}
<ul class="list-unstyled d-flex align-items-center mb-0 {{ class }}">
  {%- for network in networks -%}
    {%- assign setting = 'social_' | append: network | append: '_link' -%}
    {%- if settings[setting] != blank -%}
      {%- assign icon = network -%}
      {%- if network == 'twitter' %}{% assign icon = 'twitter-x' %}{% endif -%}
      <li>
        <a href="{{ settings[setting] | escape }}" class="d-block text-{{ colors[forloop.index0] }} {{ link_class }}" target="_blank" rel="noopener">
          {%- render 'icon', name: icon -%}
          <span class="visually-hidden">{{ labels[forloop.index0] }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
